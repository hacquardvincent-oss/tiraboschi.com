<!-- /sections/header.liquid — TIRABOSCHI PARIS -->

{%- liquid
  assign transparent_header = false
  if template contains 'collection' and collection.image and section.settings.transparent_collection
    assign transparent_header = true
  elsif template contains 'article' and article.image and section.settings.transparent_article
    assign transparent_header = true
  elsif template contains 'blog' and section.settings.transparent_blog
    assign transparent_header = true
  elsif template contains 'page' and section.settings.transparent_page
    assign transparent_header = true
  elsif template == 'index' and section.settings.transparent_home
    assign transparent_header = true
  endif

  assign width_wrapper_class = 'wrapper'
  if section.settings.full_width
    assign width_wrapper_class = 'wrapper--full'
  endif

  if section.settings.main_menu_linklist
    assign main_menu_linklist = section.settings.main_menu_linklist
  else
    assign main_menu_linklist = 'main-menu'
  endif

  assign toolbar_blocks = section.blocks | where: 'type', 'toolbar'
  if toolbar_blocks.size > 0
    for block in toolbar_blocks
      if block.type == 'toolbar'
        assign linkz = block.settings.secondary_linklist
        if block.settings.show_menu_mobile and linkz != blank
          assign drawer_links = linkz
        endif
        if block.settings.show_currency_mobile and localization.available_countries.size > 1
          assign drawer_currency = true
        endif
        if block.settings.show_locale_mobile and localization.available_languages.size > 1
          assign drawer_locale = true
        endif
        break
      endif
    endfor
  endif

  assign logo_width = section.settings.logo_max_limit | times: 1
  assign overlay_color = section.settings.transparent_text_color
  assign color_overlay_brightness = overlay_color | color_brightness
  if color_overlay_brightness <= 127
    assign overlay_color = overlay_color | color_lighten: 100
  else
    assign overlay_color = overlay_color | color_darken: 100
  endif
  assign overlay_color = overlay_color | color_modify: 'alpha', 0.20

  capture account_icon
    if section.settings.icons_type == 'modern'
      render 'icon-set-mod-user'
    elsif section.settings.icons_type == 'classic'
      render 'icon-set-classic-user'
    endif
  endcapture

  capture hamburger_icon
    if section.settings.icons_type == 'modern'
      render 'icon-set-mod-hamburger'
    elsif section.settings.icons_type == 'classic'
      render 'icon-set-classic-hamburger'
    endif
  endcapture

  capture search_icon
    if section.settings.icons_type == 'modern'
      render 'icon-set-mod-search'
    elsif section.settings.icons_type == 'classic'
      render 'icon-set-classic-search'
    endif
  endcapture

  capture cart_icon
    if section.settings.icons_type == 'modern'
      case section.settings.cart_icon
        when 'cart'
          render 'icon-set-mod-cart'
        when 'bag'
          render 'icon-set-mod-bag'
        when 'basket'
          render 'icon-set-mod-basket'
      endcase
    elsif section.settings.icons_type == 'classic'
      case section.settings.cart_icon
        when 'cart'
          render 'icon-set-classic-cart'
        when 'bag'
          render 'icon-set-classic-bag'
        when 'basket'
          render 'icon-set-classic-basket'
      endcase
    endif
  endcapture
-%}

{% style %}
  :root {
    --COLOR-NAV-TEXT-TRANSPARENT: {{ section.settings.transparent_text_color }};
    --COLOR-HEADER-TRANSPARENT-GRADIENT: {{ overlay_color }};
    --LOGO-PADDING: {{ section.settings.logo_padding | append: 'px' }};
    --menu-backfill-height: auto;
  }
{% endstyle %}

{% capture logos %}
  {%- if transparent_header and section.settings.transparent_logo != blank -%}
    {%- assign has_transparent_logo = true -%}
  {%- endif -%}
  <div class="header__logo{% if section.settings.logo %} header__logo--image{% endif %}{% if has_transparent_logo %} header__logo--has-transparent{% endif %}">
    <a class="header__logo__link" href="{{ routes.root_url }}" style="--LOGO-WIDTH: {{ logo_width }}px">
      {% if section.settings.logo != blank %}
        {%- assign alt = section.settings.logo.alt | default: shop.name | strip_html | escape -%}
        {%- assign logo_width_2x = logo_width | times: 2 -%}
        {%- assign logo_width_3x = logo_width | times: 3 -%}
        {% capture srcset %}{{ section.settings.logo | image_url: width: logo_width_2x }} 2x, {{ section.settings.logo | image_url: width: logo_width_3x }} 3x, {{ section.settings.logo | image_url: width: logo_width }}{% endcapture %}
        {{ section.settings.logo | image_url: width: logo_width | image_tag: class: "logo__img logo__img--color", srcset: srcset, alt: alt, preload: true }}
      {% else %}
        {%- assign text_logo_setting = section.settings.logo_text_size | prepend: 'accent-size-' -%}
        <div class="header__logo__text {{ text_logo_setting }}"><span>{{ shop.name }}</span></div>
      {% endif %}
      {% if has_transparent_logo %}
        {%- assign alt = section.settings.transparent_logo.alt | default: shop.name | strip_html | escape -%}
        {%- assign transparent_logo_width = logo_width | at_most: section.settings.logo_max_limit -%}
        {%- assign transparent_logo_width_2x = transparent_logo_width | times: 2 -%}
        {% capture srcset %}{{ section.settings.transparent_logo | image_url: width: transparent_logo_width_2x }} 2x, {{ section.settings.transparent_logo | image_url: width: transparent_logo_width }}{% endcapture %}
        {{ section.settings.transparent_logo | image_url: width: transparent_logo_width | image_tag: class: "logo__img logo__img--transparent", srcset: srcset, alt: alt, preload: true }}
      {% endif %}
    </a>
  </div>
{% endcapture %}

{% capture cart_status_simple %}
  {% assign cart_full = false %}
  {%- if cart.item_count > 0 -%}{% assign cart_full = true %}{%- endif -%}
  data-header-cart-full="{{ cart_full }}"
{% endcapture %}

{% capture cart_status %}
  <span class="header__cart__status">
    <span data-header-cart-price="{{ cart.total_price }}">{{ cart.total_price | money }}</span>
    <span data-header-cart-count="{{ cart.item_count }}">({{ cart.item_count }})</span>
    <span {{ cart_status_simple }}></span>
  </span>
{% endcapture %}

{% capture cart_content %}
  <div class="header__desktop__buttons header__desktop__buttons--icons">
    {%- if shop.customer_accounts_enabled and section.settings.enable_account -%}
      <div class="header__desktop__button"><a href="{{ routes.account_url }}" class="navlink">{{ account_icon }}<span class="visually-hidden">{{ 'customer.account.title' | t }}</span></a></div>
    {% endif %}
    {% if section.settings.enable_search %}
      <div class="header__desktop__button"><a href="{{ routes.search_url }}" class="navlink" data-popdown-toggle="search-popdown">{{ search_icon }}<span class="visually-hidden">{{ 'general.search.submit' | t }}</span></a></div>
    {% endif %}
    <div class="header__desktop__button"><a href="{{ routes.cart_url }}" class="navlink navlink--cart" data-drawer-toggle="drawer-cart">{{ cart_icon }}<span class="visually-hidden">{{ 'layout.cart.title' | t }}</span>{{ cart_status }}</a></div>
  </div>
{% endcapture %}

{% capture menu %}
  <nav class="header__menu">
    <div class="header__menu__inner" data-text-items-wrapper>
      {% for link in linklists[main_menu_linklist].links %}
        {% render 'nav-item', link: link, section: section, index: forloop.index %}
      {% endfor %}
      <div class="hover__bar"></div>
      <div class="hover__bg"></div>
    </div>
  </nav>
{% endcapture %}

{%- comment -%}
  Mobile header layout (burger on far right):
  [Logo]  ·····················  [Account] [Cart] [Burger]
{%- endcomment -%}
{% capture minimal %}
  <div class="tira-mobile-left">
    {{ logos }}
  </div>
  <div class="tira-mobile-right">
    {%- if shop.customer_accounts_enabled and section.settings.enable_account -%}
      <a class="tira-btn" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
        {{ account_icon }}
      </a>
    {%- endif -%}
    <a class="tira-btn" href="{{ routes.cart_url }}" data-drawer-toggle="drawer-cart" aria-label="{{ 'layout.cart.title' | t }}">
      {{ cart_icon }}
      {{ cart_status }}
    </a>
    <button class="tira-btn tira-btn--burger"
      data-drawer-toggle="hamburger"
      aria-label="{{ 'general.accessibility.open_menu' | t }}"
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="header-menu">
      {{ hamburger_icon }}
    </button>
  </div>
{% endcapture %}

{% capture drawer %}
  <nav class="drawer header__drawer display-none"
    data-drawer="hamburger"
    aria-label="{{ 'general.accessibility.main_menu' | t }}"
    id="header-menu">
    <div class="drawer__content">
      <div class="drawer__top">
        <div class="drawer__top__left">
          {%- if shop.customer_accounts_enabled and section.settings.enable_account -%}
            <a class="drawer__account" href="{{ routes.account_url }}">{{ account_icon }}<span class="visually-hidden">{{ 'customer.account.title' | t }}</span></a>
          {%- endif -%}
        </div>
        <button class="drawer__button drawer__close" data-first-focus data-drawer-toggle="hamburger" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon-core-x' %}</button>
      </div>
      <div class="drawer__inner" data-drawer-scrolls>
        {%- assign mobile_menu_linklist = section.settings.mobile_menu_linklist | default: main_menu_linklist -%}
        <div class="drawer__menu" data-stagger-animation data-sliderule-pane="0">
          {% assign menu_index = 0 %}
          {% for link in linklists[mobile_menu_linklist].links %}
            {% render 'nav-item-mobile', link: link, section: section, index: forloop.index %}
            {% assign menu_index = forloop.index %}
          {% endfor %}
          {% if drawer_links %}
            {% assign secondary_index = menu_index | plus: 1 %}
            {% for link in linklists[drawer_links].links %}
              {% render 'nav-item-mobile', link: link, section: section, index: secondary_index, secondary_menu: true %}
              {% assign secondary_index = secondary_index | plus: forloop.index %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
    <span class="drawer__underlay" data-drawer-underlay>
      <span class="drawer__underlay__fill"></span>
      <span class="drawer__underlay__blur"></span>
    </span>
  </nav>
{% endcapture %}

<div class="header__wrapper"
  data-header-wrapper
  style="--bar-opacity: 0; --bar-width: 0; --bar-left: 0;"
  data-header-transparent="{{ transparent_header }}"
  data-underline-current="{{ section.settings.underline_current }}"
  data-header-sticky="{{ section.settings.header_sticky }}"
  data-header-style="{{ section.settings.header_style }}"
  data-section-id="{{ section.id }}"
  data-section-type="header">
  <header class="theme__header" data-header-height>
    <div class="header__inner" {{ cart_status_simple }}>
      <div class="{{ width_wrapper_class }}">
        <div class="header__mobile tira-header-mobile">{{ minimal }}</div>
        <div data-header-desktop class="header__desktop header__desktop--{{ section.settings.header_style }}">
          {%- case section.settings.header_style -%}
            {%- when 'logo_center' -%}
              <div data-takes-space class="header__desktop__bar__l">{{ menu }}</div>
              <div data-takes-space class="header__desktop__bar__c">{{ logos }}</div>
              <div data-takes-space class="header__desktop__bar__r">{{ cart_content }}</div>
            {%- when 'menu_center' -%}
              <div data-takes-space class="header__desktop__bar__l">{{ logos }}</div>
              <div data-takes-space class="header__desktop__bar__c">{{ menu }}</div>
              <div data-takes-space class="header__desktop__bar__r">{{ cart_content }}</div>
            {%- when 'split' -%}
              <div data-takes-space class="header__desktop__bar__l">{{ logos }}</div>
              <div data-takes-space class="header__desktop__bar__r"><div class="header__desktop__bar__inline">{{ menu }}{{ cart_content }}</div></div>
            {%- when 'drawer' -%}
              <div data-takes-space class="header__desktop__bar__l">{{ logos }}</div>
              <div data-takes-space class="header__desktop__bar__r">{{ cart_content }}</div>
          {%- endcase -%}
        </div>
      </div>
    </div>
    {%- comment -%} Search bar visible below header on mobile (Miu Miu style) {%- endcomment -%}
    {%- if section.settings.enable_search -%}
      <div class="tira-header-search header__mobile">
        <div class="{{ width_wrapper_class }}">
          {%- render 'search-bar' -%}
        </div>
      </div>
    {%- endif -%}
  </header>
  {{ drawer }}
  <div data-product-add-popdown-wrapper class="product-add-popdown"></div>
</div>

<div class="header__backfill" data-header-backfill style="height: var(--menu-backfill-height);"></div>

<script type="application/ld+json">
{"@context":"http://schema.org","@type":"Organization","name":{{ shop.name | json }},{% if section.settings.logo %}{% assign image_size = section.settings.logo.width | append: 'x' %}"logo":{{ section.settings.logo | img_url: image_size | prepend: "https:" | json }},{% endif %}"sameAs":[{{ settings.social_instagram_link | json }}],"url":{{ shop.url | append: page.url | json }}}
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {"type":"select","id":"header_style","label":"Header style","default":"drawer","options":[{"value":"logo_center","label":"Menu | Logo | Cart"},{"value":"menu_center","label":"Logo | Menu | Cart"},{"value":"split","label":"Logo | Spacer | Menu + Cart"},{"value":"drawer","label":"Mobile drawer menu"}]},
    {"type":"image_picker","id":"logo","label":"Logo image"},
    {"type":"range","id":"logo_max_limit","min":5,"max":495,"step":5,"unit":"px","label":"Logo width","default":120},
    {"type":"range","id":"logo_padding","min":0,"max":50,"step":1,"unit":"px","label":"Logo padding","default":15},
    {"type":"range","id":"logo_text_size","label":"Logo text size","min":1,"max":15,"step":1,"default":5},
    {"type":"header","content":"Links"},
    {"type":"link_list","label":"Menu","id":"main_menu_linklist"},
    {"type":"link_list","label":"Mobile menu (optional)","id":"mobile_menu_linklist"},
    {"type":"checkbox","id":"full_width","default":true,"label":"Full width"},
    {"type":"checkbox","id":"underline_current","default":false,"label":"Underline current page"},
    {"type":"checkbox","id":"enable_search","default":true,"label":"Show search bar under header (mobile)"},
    {"type":"checkbox","id":"enable_account","default":true,"label":"Show account link"},
    {"type":"checkbox","id":"use_icons","label":"Use icons","default":true},
    {"type":"select","id":"icons_type","label":"Icons type","default":"modern","options":[{"value":"classic","label":"Classic"},{"value":"modern","label":"Modern"}]},
    {"type":"select","id":"cart_icon","label":"Cart icon","default":"bag","options":[{"value":"basket","label":"Basket"},{"value":"bag","label":"Bag"},{"value":"cart","label":"Cart"}]},
    {"type":"header","content":"Sticky header"},
    {"type":"select","id":"header_sticky","label":"Header scroll behavior","default":"sticky","options":[{"value":"static","label":"Default"},{"value":"sticky","label":"Sticky header"},{"value":"directional","label":"Sticky only when scrolling up"}]},
    {"type":"header","content":"Transparent header"},
    {"type":"checkbox","id":"transparent_home","label":"Enable on the home page","default":true},
    {"type":"checkbox","id":"transparent_collection","label":"Enable on collections","default":true},
    {"type":"checkbox","id":"transparent_blog","label":"Enable on the blog","default":true},
    {"type":"checkbox","id":"transparent_article","label":"Enable on articles","default":true},
    {"type":"checkbox","id":"transparent_page","label":"Enable on pages","default":true},
    {"type":"color","id":"transparent_text_color","label":"Text and icons color","default":"#fef6ec"},
    {"type":"image_picker","id":"transparent_logo","label":"Transparent header logo"},
    {"type":"header","content":"Collection images"},
    {"type":"checkbox","id":"show_collection_images","label":"Show collection images","default":true},
    {"type":"range","id":"collection_wh_ratio","min":0.5,"max":5,"step":0.1,"unit":":1","label":"Collection image height","default":2.5}
  ],
  "blocks": [
    {"name":"Toolbar","type":"toolbar","limit":1,"settings":[{"type":"richtext","id":"announcement_text","label":"Text","default":"<p>Announcement</p>"},{"type":"link_list","id":"secondary_linklist","label":"Secondary menu"},{"type":"checkbox","id":"show_menu_desktop","label":"Show on desktop","default":true},{"type":"checkbox","id":"show_menu_mobile","label":"Show in mobile drawer","default":true},{"type":"checkbox","id":"show_locale_desktop","label":"Show locale on desktop","default":true},{"type":"checkbox","id":"show_locale_mobile","label":"Show locale in drawer","default":true},{"type":"checkbox","id":"show_currency_desktop","label":"Show currency on desktop","default":true},{"type":"checkbox","id":"show_currency_mobile","label":"Show currency in drawer","default":true}]},
    {"name":"Image","type":"image","settings":[{"type":"select","id":"position","label":"Menu item position","default":"1","options":[{"value":"1","label":"Item 1"},{"value":"2","label":"Item 2"},{"value":"3","label":"Item 3"},{"value":"4","label":"Item 4"},{"value":"5","label":"Item 5"}]},{"type":"range","id":"wh_ratio","min":0,"max":3,"step":0.1,"unit":":1","label":"Image ratio","default":1.2},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"wide_element","label":"Wide element","default":false},{"type":"range","id":"overlay_opacity","min":0,"max":100,"step":5,"label":"Overlay opacity","default":0},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#000"},{"type":"text","id":"title","label":"Title"},{"type":"select","id":"title_color","label":"Title color","default":"text--white","options":[{"value":"text--neutral","label":"Normal"},{"value":"text--white","label":"White"},{"value":"text--black","label":"Black"}]},{"type":"select","id":"button_style","label":"Button layout","default":"is-below-image","options":[{"value":"text-button","label":"Small button"},{"value":"is-on-image","label":"Overlay on hover"},{"value":"is-below-image","label":"Below image"}]},{"type":"text","id":"link_text","label":"Link text","default":"Shop All"},{"type":"url","id":"link","label":"Link","default":"/collections/all"},{"type":"select","id":"button_color","label":"Button color","default":"btn--neutral","options":[{"value":"btn--primary","label":"Primary"},{"value":"btn--neutral","label":"Text color"},{"value":"btn--black","label":"Black"},{"value":"btn--white","label":"White"}]},{"type":"select","id":"display","label":"Show on","default":"desktop","options":[{"value":"all","label":"All devices"},{"value":"mobile","label":"Mobile only"},{"value":"desktop","label":"Desktop only"}]}]}
  ],
  "enabled_on": {"groups": ["header"]}
}
{% endschema %}
