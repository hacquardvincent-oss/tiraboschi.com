{% comment %} TIRABOSCHI · Reset password {% endcomment %}
<div class="tira-account-page">
  <div class="tira-account__form-wrap">
    <h1 class="tira-account__title">Nouveau mot de passe</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="tira-form__field">
        <label for="Password">Nouveau mot de passe</label>
        <input type="password" name="customer[password]" id="Password" autocomplete="new-password">
      </div>
      <div class="tira-form__field">
        <label for="PasswordConfirmation">Confirmation</label>
        <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" autocomplete="new-password">
      </div>
      <button type="submit" class="tira-account__btn">Mettre à jour</button>
    {% endform %}
  </div>
</div>
