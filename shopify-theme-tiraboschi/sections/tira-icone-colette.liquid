{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Icône Colette — Page éditoriale modèle iconique
  ═══════════════════════════════════════════════════════════════
  Structure identique à tira-icone-victoire.liquid
  Adaptée au modèle Colette (1938, format compact, versatile)
{% endcomment %}

<style>
  .col-page {
    --tira-black: #0a0a0a;
    --tira-white: #ffffff;
    --tira-grey: #f7f5f2;
    --tira-border: #e8e8e8;
    --tira-ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--tira-black);
  }

  /* ── 1. Hero ── */
  .col-hero {
    position: relative;
    height: 100vh; min-height: 600px;
    background: var(--tira-black);
    overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding-bottom: 64px;
  }
  .col-hero__img { position: absolute; inset: 0; overflow: hidden; }
  .col-hero__img img {
    width: 100%; height: 100%; object-fit: cover; opacity: .65;
    animation: col-kb 14s ease-in-out infinite alternate;
  }
  @keyframes col-kb {
    from { transform: scale(1); }
    to   { transform: scale(1.07) translate(-1.5%, -1%); }
  }
  .col-hero::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,.75) 0%, rgba(10,10,10,.2) 50%, rgba(10,10,10,.1) 100%);
    z-index: 1;
  }
  .col-hero__filigree {
    position: absolute; bottom: 0; left: 50%;
    transform: translateX(-50%);
    font-size: clamp(120px, 18vw, 280px);
    font-style: italic; color: var(--tira-white);
    opacity: .06; white-space: nowrap;
    z-index: 2; pointer-events: none;
    line-height: 1; letter-spacing: -0.02em;
  }
  .col-hero__content {
    position: relative; z-index: 3;
    text-align: center; color: var(--tira-white);
    padding: 0 40px;
  }
  .col-hero__content h1 {
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 400; letter-spacing: -0.01em;
    line-height: 1; margin: 0 0 16px; color: var(--tira-white);
  }
  .col-hero__sub {
    font-size: 11px; text-transform: uppercase; letter-spacing: .15em;
    font-style: italic; opacity: .7;
  }
  .col-hero__cta {
    position: absolute; bottom: 40px; right: 48px;
    z-index: 3; text-align: right; color: var(--tira-white);
  }
  .col-hero__cta .col-meta {
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
    opacity: .6; display: block; margin-bottom: 6px;
  }
  .col-hero__cta a {
    font-size: 11px; text-transform: uppercase; letter-spacing: .12em;
    text-decoration: underline; text-underline-offset: 3px;
    color: var(--tira-white); transition: opacity .2s;
  }
  .col-hero__cta a:hover { opacity: .6; }

  /* ── 2. L'Origine ── */
  .col-origine { background: var(--tira-white); padding: 120px 40px; text-align: center; }
  .col-origine__inner { max-width: 720px; margin: 0 auto; }
  .col-label {
    display: block;
    font-size: 11px; text-transform: uppercase; letter-spacing: .15em;
    opacity: .5; margin-bottom: 28px;
  }
  .col-origine p { font-size: 18px; line-height: 1.75; margin-bottom: 48px; opacity: .85; }
  .col-origine__quote {
    font-size: clamp(22px, 3.5vw, 32px);
    font-style: italic; line-height: 1.4; letter-spacing: -0.01em;
    border-top: 1px solid var(--tira-border);
    border-bottom: 1px solid var(--tira-border);
    padding: 32px 0; margin-top: 48px;
  }

  /* ── 3. La Silhouette ── */
  .col-silhouette { background: var(--tira-grey); padding: 0; }
  .col-silhouette__grid {
    display: grid; grid-template-columns: 60fr 40fr; min-height: 700px;
  }
  .col-silhouette__img { position: relative; overflow: hidden; background: #1a1a1a; }
  .col-silhouette__img img { width: 100%; height: 100%; object-fit: cover; opacity: .8; }
  .col-silhouette__content {
    padding: 80px 60px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .col-silhouette__content h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400; letter-spacing: -0.01em; line-height: 1.1; margin-bottom: 28px;
  }
  .col-silhouette__content > p { font-size: 15px; line-height: 1.8; opacity: .8; margin-bottom: 32px; }
  .col-silhouette__dims {
    font-size: 12px; letter-spacing: .08em; opacity: .6; line-height: 2;
    border-top: 1px solid var(--tira-border); padding-top: 20px; margin-bottom: 20px;
  }
  .col-silhouette__dims span { display: block; }
  .col-note { font-size: 13px; opacity: .6; margin-bottom: 28px; line-height: 1.7; }

  /* ── 4. Les Matières ── */
  .col-matieres { background: var(--tira-white); padding: 100px 40px; }
  .col-matieres__header { text-align: center; margin-bottom: 64px; }
  .col-matieres__title {
    font-size: clamp(28px, 4vw, 40px); font-weight: 400; letter-spacing: -0.01em;
  }
  .col-matieres__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 2px; max-width: 1100px; margin: 0 auto;
  }
  .col-mat-card { padding: 40px 28px; border: 1px solid var(--tira-border); transition: background .3s; }
  .col-mat-card:hover { background: var(--tira-grey); }
  .col-mat-card__swatch { width: 80px; height: 100px; margin-bottom: 24px; }
  .col-mat-card__name { font-size: 15px; margin-bottom: 10px; }
  .col-mat-card__desc { font-size: 12px; opacity: .6; line-height: 1.6; margin-bottom: 16px; }
  .col-mat-card__avail {
    display: flex; align-items: center; gap: 6px;
    font-size: 10px; text-transform: uppercase; letter-spacing: .12em; opacity: .5;
  }
  .col-mat-card__avail-dot { width: 5px; height: 5px; background: var(--tira-black); border-radius: 50%; }
  .col-sw-pleine-fleur { background: linear-gradient(135deg, #8b6b4a 0%, #6b4f35 40%, #7d5f43 100%); }
  .col-sw-veau-gras    { background: linear-gradient(135deg, #c4a882 0%, #a8876a 40%, #b89872 100%); }
  .col-sw-veau-box     { background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 50%, #333 100%); }
  .col-sw-agneau-nappa { background: linear-gradient(135deg, #d4c4a8 0%, #c0ad90 40%, #ddd0b8 100%); }

  /* ── 5. La Palette ── */
  .col-palette { background: var(--tira-grey); padding: 100px 40px; text-align: center; }
  .col-palette__title {
    font-size: clamp(28px, 4vw, 40px); font-weight: 400; letter-spacing: -0.01em; margin-bottom: 56px;
  }
  .col-palette__grid {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 32px;
    max-width: 700px; margin: 0 auto 48px;
  }
  .col-cswatch { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .col-cswatch__sq { width: 48px; height: 48px; transition: transform .3s var(--tira-ease); }
  .col-cswatch:hover .col-cswatch__sq { transform: scale(1.1); }
  .col-cswatch__name { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; opacity: .6; }
  .col-sw-noir     { background: #1a1a1a; }
  .col-sw-marine   { background: #1a2a3a; }
  .col-sw-chocolat { background: #3d2010; }
  .col-sw-bordeaux { background: #5c1a28; }
  .col-sw-cognac   { background: #8b5a2b; }
  .col-sw-sable    { background: #c4a882; }
  .col-sw-naturel  { background: #d4c4a8; }
  .col-sw-ivoire   { background: #f0e8d8; border: 1px solid var(--tira-border); }
  .col-palette__note {
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em; opacity: .45; font-style: italic;
  }

  /* ── 6. La Fabrication ── */
  .col-fabrication { background: var(--tira-black); color: var(--tira-white); padding: 0; }
  .col-fabrication__grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; }
  .col-fabrication__content {
    padding: 100px 80px; display: flex; flex-direction: column; justify-content: center;
  }
  .col-fabrication__content .col-label { color: rgba(255,255,255,.5); }
  .col-fabrication__content h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400; letter-spacing: -0.01em; line-height: 1.1;
    margin-bottom: 28px; color: var(--tira-white);
  }
  .col-fabrication__content > p { font-size: 15px; line-height: 1.85; opacity: .75; margin-bottom: 40px; }
  .col-fab-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
    border-top: 1px solid rgba(255,255,255,.12); padding-top: 32px;
  }
  .col-fab-stats__label {
    font-size: 10px; text-transform: uppercase; letter-spacing: .12em; opacity: .45; margin-bottom: 4px;
  }
  .col-fab-stats__value { font-size: 14px; letter-spacing: .02em; }
  .col-fabrication__img {
    background: linear-gradient(135deg, #1a1210 0%, #2d2018 30%, #1a1510 60%, #261c12 100%);
    position: relative; overflow: hidden;
  }
  .col-fabrication__img img { width: 100%; height: 100%; object-fit: cover; opacity: .6; mix-blend-mode: luminosity; }

  /* ── 7. Témoignages ── */
  .col-temoignages { background: var(--tira-white); padding: 100px 40px; }
  .col-temoignages__header { text-align: center; margin-bottom: 72px; }
  .col-temoignages__header h2 {
    font-size: clamp(28px, 4vw, 40px); font-weight: 400; letter-spacing: -0.01em;
  }
  .col-temoignages__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 48px 64px; max-width: 1100px; margin: 0 auto;
  }
  .col-temoignage { border-top: 1px solid var(--tira-border); padding-top: 32px; }
  .col-temoignage__text { font-size: 15px; font-style: italic; line-height: 1.75; margin-bottom: 24px; opacity: .85; }
  .col-temoignage__author {
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em; opacity: .45; font-style: normal;
  }

  /* ── 8. Sur Mesure ── */
  .col-sur-mesure { background: var(--tira-grey); padding: 100px 40px; text-align: center; }
  .col-sur-mesure__inner { max-width: 680px; margin: 0 auto; }
  .col-sur-mesure__inner h2 {
    font-size: clamp(32px, 4.5vw, 48px); font-weight: 400; letter-spacing: -0.01em; margin-bottom: 24px;
  }
  .col-sur-mesure__inner > p { font-size: 16px; line-height: 1.8; opacity: .8; margin-bottom: 40px; }
  .col-sur-mesure__options {
    list-style: none; text-align: left;
    margin: 0 auto 48px; max-width: 440px;
    border-top: 1px solid var(--tira-border);
  }
  .col-sur-mesure__options li {
    padding: 16px 0; border-bottom: 1px solid var(--tira-border); font-size: 14px; opacity: .75;
  }
  .col-sur-mesure__options li::before { content: '— '; opacity: .4; }
  .col-sur-mesure__ctas { display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; }
  .col-sur-mesure__ctas a {
    font-size: 13px; letter-spacing: .1em; text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 3px; transition: opacity .2s;
  }
  .col-sur-mesure__ctas a:hover { opacity: .6; }

  /* ── 9. Découvrir aussi ── */
  .col-decouvrir { background: var(--tira-white); padding: 100px 40px; }
  .col-decouvrir__header { margin-bottom: 56px; }
  .col-decouvrir__header h2 { font-size: 24px; font-weight: 400; letter-spacing: .02em; }
  .col-decouvrir__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; max-width: 1100px;
  }
  .col-prod-card { overflow: hidden; }
  .col-prod-card__img {
    display: block; aspect-ratio: 3/4; background: var(--tira-grey);
    margin-bottom: 16px; overflow: hidden; position: relative;
  }
  .col-prod-card__img img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform .6s var(--tira-ease);
  }
  .col-prod-card:hover .col-prod-card__img img { transform: scale(1.04); }
  .col-prod-card__name { font-size: 14px; margin-bottom: 4px; }
  .col-prod-card__price { font-size: 12px; opacity: .5; margin-bottom: 10px; letter-spacing: .04em; }
  .col-prod-card__cta {
    font-size: 11px; text-transform: uppercase; letter-spacing: .12em;
    text-decoration: underline; text-underline-offset: 3px; transition: opacity .2s;
  }
  .col-prod-card__cta:hover { opacity: .6; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .col-hero { padding-bottom: 48px; }
    .col-hero__content { padding: 0 20px; }
    .col-hero__cta { right: 20px; bottom: 24px; }
    .col-origine { padding: 80px 20px; }
    .col-origine p { font-size: 16px; }
    .col-silhouette__grid { grid-template-columns: 1fr; }
    .col-silhouette__img { min-height: 380px; }
    .col-silhouette__content { padding: 48px 24px; }
    .col-matieres { padding: 72px 0; }
    .col-matieres__header { padding: 0 20px; }
    .col-matieres__grid {
      grid-template-columns: repeat(4, 260px);
      overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 1px; padding: 0 20px 24px; scrollbar-width: none;
    }
    .col-matieres__grid::-webkit-scrollbar { display: none; }
    .col-mat-card { scroll-snap-align: start; }
    .col-palette { padding: 72px 20px; }
    .col-fabrication__grid { grid-template-columns: 1fr; }
    .col-fabrication__img { min-height: 320px; order: -1; }
    .col-fabrication__content { padding: 64px 24px; }
    .col-fab-stats { grid-template-columns: 1fr 1fr; }
    .col-temoignages { padding: 72px 20px; }
    .col-temoignages__grid { grid-template-columns: 1fr; gap: 36px; }
    .col-sur-mesure { padding: 72px 20px; }
    .col-decouvrir { padding: 72px 20px; }
    .col-decouvrir__grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 480px) {
    .col-matieres__grid { grid-template-columns: repeat(4, 80vw); }
  }
</style>

<div class="col-page">

  {%- comment -%} ── 1. HERO ── {%- endcomment -%}
  <section class="col-hero" aria-label="La Colette — Icône TIRABOSCHI Paris">
    <div class="col-hero__img">
      <img
        src="{{ 'https://cdn.shopify.com/s/files/1/0927/5890/1079/files/BOSCHI0919.jpg' }}"
        alt="La Colette — Sac iconique TIRABOSCHI Paris"
        loading="eager" fetchpriority="high" width="1920" height="1080">
    </div>
    <div class="col-hero__filigree" aria-hidden="true">Colette</div>
    <div class="col-hero__content">
      <h1 data-words>La Colette</h1>
      <p class="col-hero__sub">Née en 1938. La liberté dans la main.</p>
    </div>
    <div class="col-hero__cta" data-reveal>
      <span class="col-meta">FW25 · À partir de 1 950€</span>
      <a href="{{ routes.root_url }}products/colette">Découvrir la boutique →</a>
    </div>
  </section>

  {%- comment -%} ── 2. L'ORIGINE ── {%- endcomment -%}
  <section class="col-origine">
    <div class="col-origine__inner">
      <span class="col-label" data-reveal>L'Icône</span>
      <p data-reveal>
        En 1938, la maison crée un sac plus compact pour accompagner les femmes en mouvement.
        Baptisé Colette — en hommage à la romancière parisienne —, il reprend les codes de la Victoire
        dans un format allégé. Même V structurant, même sellier, même engagement.
        Pour celles qui refusent de choisir entre élégance et liberté.
      </p>
      <blockquote class="col-origine__quote" data-reveal>
        "Légère comme une promesse. Solide comme un serment."
      </blockquote>
    </div>
  </section>

  {%- comment -%} ── 3. LA SILHOUETTE ── {%- endcomment -%}
  <section class="col-silhouette" aria-label="La silhouette de la Colette">
    <div class="col-silhouette__grid">
      <div class="col-silhouette__img">
        {%- assign colette = all_products['colette'] -%}
        {%- if colette and colette.featured_image -%}
          <img
            src="{{ colette.featured_image | image_url: width: 900 }}"
            alt="{{ colette.title }} — TIRABOSCHI Paris"
            loading="lazy" width="900" height="1200">
        {%- else -%}
          <img
            src="{{ 'https://cdn.shopify.com/s/files/1/0927/5890/1079/files/BOSCHI0919.jpg' }}"
            alt="La Colette — TIRABOSCHI Paris"
            loading="lazy" width="900" height="1200">
        {%- endif -%}
      </div>
      <div class="col-silhouette__content">
        <span class="col-label" data-reveal>La Forme</span>
        <h2 data-words>La silhouette</h2>
        <p data-reveal>
          Plus petite, tout aussi structurée. La Colette porte les mêmes codes — la forme en V,
          l'anse en tête de cuir — dans un format qui passe de la réunion au dîner sans effort.
        </p>
        <div class="col-silhouette__dims" data-reveal>
          <span>Hauteur&nbsp;&nbsp;&nbsp;&nbsp;22 cm</span>
          <span>Largeur&nbsp;&nbsp;&nbsp;&nbsp;28 cm</span>
          <span>Profondeur&nbsp;10 cm</span>
        </div>
        <p class="col-note" data-reveal>
          Contient&nbsp;: portefeuille, téléphone, clés, maquillage essentiel. Passe en cabine avion.
        </p>
        <a href="{{ routes.root_url }}products/colette" class="tira-btn" data-reveal>
          Voir le produit →
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ── 4. LES MATIÈRES ── {%- endcomment -%}
  <section class="col-matieres" aria-label="Les matières disponibles pour la Colette">
    <div class="col-matieres__header">
      <span class="col-label" data-reveal>Le Choix</span>
      <h2 class="col-matieres__title" data-words>La Colette selon votre matière</h2>
    </div>
    <div class="col-matieres__grid">
      <article class="col-mat-card" data-reveal>
        <div class="col-mat-card__swatch col-sw-pleine-fleur"></div>
        <p class="col-mat-card__name">Veau Pleine Fleur</p>
        <p class="col-mat-card__desc">La noblesse du cuir naturel — grain serré, tenue exceptionnelle, patine lumineuse.</p>
        <div class="col-mat-card__avail">
          <span class="col-mat-card__avail-dot"></span>Disponible
        </div>
      </article>
      <article class="col-mat-card" data-reveal>
        <div class="col-mat-card__swatch col-sw-veau-gras"></div>
        <p class="col-mat-card__name">Veau Gras</p>
        <p class="col-mat-card__desc">Souplesse absolue, toucher velouté. Le cuir qui s'assouplit dès le premier jour.</p>
        <div class="col-mat-card__avail">
          <span class="col-mat-card__avail-dot"></span>Disponible
        </div>
      </article>
      <article class="col-mat-card" data-reveal>
        <div class="col-mat-card__swatch col-sw-veau-box"></div>
        <p class="col-mat-card__name">Veau Box</p>
        <p class="col-mat-card__desc">Lisse, brillant, architectural. La matière des grandes maisons parisiennes.</p>
        <div class="col-mat-card__avail">
          <span class="col-mat-card__avail-dot"></span>Disponible
        </div>
      </article>
      <article class="col-mat-card" data-reveal>
        <div class="col-mat-card__swatch col-sw-agneau-nappa"></div>
        <p class="col-mat-card__name">Agneau Nappa</p>
        <p class="col-mat-card__desc">Légèreté, douceur intense, main inimitable. Le cuir des après-midis parisiens.</p>
        <div class="col-mat-card__avail">
          <span class="col-mat-card__avail-dot"></span>Disponible
        </div>
      </article>
    </div>
  </section>

  {%- comment -%} ── 5. LA PALETTE FW25 ── {%- endcomment -%}
  <section class="col-palette" aria-label="Palette de couleurs FW25">
    <span class="col-label" data-reveal>FW25</span>
    <h2 class="col-palette__title" data-words>La palette</h2>
    <div class="col-palette__grid" data-reveal>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-noir"></div><span class="col-cswatch__name">Noir</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-marine"></div><span class="col-cswatch__name">Marine</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-chocolat"></div><span class="col-cswatch__name">Chocolat</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-bordeaux"></div><span class="col-cswatch__name">Bordeaux</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-cognac"></div><span class="col-cswatch__name">Cognac</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-sable"></div><span class="col-cswatch__name">Sable</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-naturel"></div><span class="col-cswatch__name">Naturel</span></div>
      <div class="col-cswatch"><div class="col-cswatch__sq col-sw-ivoire"></div><span class="col-cswatch__name">Ivoire</span></div>
    </div>
    <p class="col-palette__note" data-reveal>Toutes les teintes sont disponibles en commande — délai 4–6 semaines</p>
  </section>

  {%- comment -%} ── 6. LA FABRICATION ── {%- endcomment -%}
  <section class="col-fabrication" aria-label="Fabrication artisanale de la Colette">
    <div class="col-fabrication__grid">
      <div class="col-fabrication__content">
        <span class="col-label" data-reveal>Le Savoir-Faire</span>
        <h2 data-words>48 à 72 heures<br>de travail</h2>
        <p data-reveal>
          Chaque Colette est façonnée de A à Z par un seul artisan.
          Même couture sellier à deux aiguilles, même cuir sélectionné, même exigence.
          La taille change. L'âme reste.
        </p>
        <div class="col-fab-stats" data-reveal>
          <div>
            <p class="col-fab-stats__label">Artisans</p>
            <p class="col-fab-stats__value">1 par sac</p>
          </div>
          <div>
            <p class="col-fab-stats__label">Couture sellier</p>
            <p class="col-fab-stats__value">12 heures</p>
          </div>
          <div>
            <p class="col-fab-stats__label">Points de couture</p>
            <p class="col-fab-stats__value">2 800</p>
          </div>
          <div>
            <p class="col-fab-stats__label">Traçabilité</p>
            <p class="col-fab-stats__value">Certificat signé</p>
          </div>
        </div>
      </div>
      <div class="col-fabrication__img" aria-hidden="true">
        <img
          src="{{ 'https://cdn.shopify.com/s/files/1/0927/5890/1079/files/BOSCHI0154.jpg' }}"
          alt="" loading="lazy" width="960" height="1280">
      </div>
    </div>
  </section>

  {%- comment -%} ── 7. LES TÉMOIGNAGES ── {%- endcomment -%}
  <section class="col-temoignages" aria-label="Témoignages clientes">
    <div class="col-temoignages__header">
      <span class="col-label" data-reveal>Elles la portent</span>
      <h2 data-words>Quelques mots</h2>
    </div>
    <div class="col-temoignages__grid">
      <blockquote class="col-temoignage" data-reveal>
        <p class="col-temoignage__text">
          "La Colette, c'est mon quotidien depuis 5 ans. Légère, parfaite.
          Je ne pars nulle part sans elle."
        </p>
        <cite class="col-temoignage__author">Éléonore V. — Paris</cite>
      </blockquote>
      <blockquote class="col-temoignage" data-reveal>
        <p class="col-temoignage__text">
          "J'hésitais avec la Victoire. Mon mari m'a offert la Colette.
          Depuis, je comprends que c'est elle qui me correspondait."
        </p>
        <cite class="col-temoignage__author">Isabelle M. — Bordeaux</cite>
      </blockquote>
      <blockquote class="col-temoignage" data-reveal>
        <p class="col-temoignage__text">
          "Petite, parfaite, indestructible. En trois mots, voilà la Colette.
          J'en ai une en Cognac et une en Noir. Ce ne sera pas la dernière."
        </p>
        <cite class="col-temoignage__author">Aurélie T. — Marseille</cite>
      </blockquote>
    </div>
  </section>

  {%- comment -%} ── 8. SUR MESURE ── {%- endcomment -%}
  <section class="col-sur-mesure" aria-label="La Colette sur mesure">
    <div class="col-sur-mesure__inner">
      <span class="col-label" data-reveal>Personnalisation</span>
      <h2 data-words>La Colette,<br>à votre façon</h2>
      <p data-reveal>
        Même palette, même liberté. La Colette se personnalise dans les mêmes conditions
        que la Victoire — teinte, couture et initiales gravées.
      </p>
      <ul class="col-sur-mesure__options" data-reveal>
        <li>Teinte au choix parmi les 48 couleurs de notre tannerie partenaire</li>
        <li>Couleur de fil de couture sellier (naturel, ivoire, bordeaux, marine ou assorti)</li>
        <li>Initiales gravées sur la quincaillerie — or, or vieilli ou argent</li>
      </ul>
      <div class="col-sur-mesure__ctas" data-reveal>
        <a href="{{ routes.root_url }}pages/sur-mesure">Configurer ma Colette →</a>
        <a href="{{ routes.root_url }}pages/prendrez-rendez-vous">Prendre rendez-vous →</a>
      </div>
    </div>
  </section>

  {%- comment -%} ── 9. DÉCOUVRIR AUSSI ── {%- endcomment -%}
  <section class="col-decouvrir" aria-label="Dans la même famille">
    <div class="col-decouvrir__header" data-reveal>
      <span class="col-label">La Famille</span>
      <h2>Dans la même famille</h2>
    </div>
    <div class="col-decouvrir__grid">
      {%- assign related = 'victoire,colette-mini,jane' | split: ',' -%}
      {%- for handle in related -%}
        {%- assign prod = all_products[handle] -%}
        {%- if prod -%}
          <article class="col-prod-card" data-reveal>
            <a class="col-prod-card__img" href="{{ prod.url }}">
              {%- if prod.featured_image -%}
                <img
                  src="{{ prod.featured_image | image_url: width: 600 }}"
                  alt="{{ prod.title }} — TIRABOSCHI Paris"
                  loading="lazy" width="600" height="800">
              {%- endif -%}
            </a>
            <div>
              <p class="col-prod-card__name">{{ prod.title }}</p>
              <p class="col-prod-card__price">À partir de {{ prod.price | money }}</p>
              <a href="{{ prod.url }}" class="col-prod-card__cta">Découvrir →</a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Icône Colette",
  "tag": "section",
  "class": "tira-section tira-section--icone-colette",
  "settings": [],
  "presets": [
    {
      "name": "Icône Colette"
    }
  ]
}
{% endschema %}
