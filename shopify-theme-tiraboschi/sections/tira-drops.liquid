    {%- endif -%}

    <p class="drp-newsletter__gdpr" data-reveal>
      En vous inscrivant, vous acceptez de recevoir les communications de TIRABOSCHI Paris.
      Désinscription possible à tout moment. Aucune donnée communiquée à des tiers.
      Conformément au RGPD et à la loi Informatique &amp; Libertés.
    </p>
  </section>

</div>

<script>
(function() {
  'use strict';

  /* ── Reveal ── */
  var revealEls = document.querySelectorAll('[data-reveal]');
  var wordsEls  = document.querySelectorAll('[data-words]');

  wordsEls.forEach(function(el) {
    el.innerHTML = el.textContent.split(' ')
      .map(function(w, i) { return '<span style="--i:' + i + '">' + w + '</span>'; })
      .join(' ');
  });

  var allReveal = Array.from(revealEls).concat(Array.from(wordsEls));
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    allReveal.forEach(function(el) { io.observe(el); });
  } else {
    allReveal.forEach(function(el) { el.classList.add('is-visible'); });
  }

  /* ── Countdown ── */
  function pad(n) { return String(n).padStart(2, '0'); }

  document.querySelectorAll('[data-countdown-end]').forEach(function(el) {
    var endStr = el.getAttribute('data-countdown-end');
    if (!endStr) return;
    var endDate = new Date(endStr).getTime();
    var daysEl  = el.querySelector('[data-cd-days]');
    var hrsEl   = el.querySelector('[data-cd-hours]');
    var minsEl  = el.querySelector('[data-cd-mins]');

    function tick() {
      var now  = Date.now();
      var diff = endDate - now;
      if (diff <= 0) {
        if (daysEl)  daysEl.textContent  = '00';
        if (hrsEl)   hrsEl.textContent   = '00';
        if (minsEl)  minsEl.textContent  = '00';
        el.setAttribute('aria-label', 'Inscriptions closes');
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000)  / 60000);
      if (daysEl)  daysEl.textContent  = pad(d);
      if (hrsEl)   hrsEl.textContent   = pad(h);
      if (minsEl)  minsEl.textContent  = pad(m);
      el.setAttribute('aria-label', 'Clôture dans ' + d + ' jours ' + h + 'h ' + m + 'min');
      setTimeout(tick, 30000);
    }
    tick();
  });

  /* ── FAQ accordion ── */
  document.querySelectorAll('.drp-faq-item__trigger').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      var item   = trigger.closest('.drp-faq-item');
      var answer = item.querySelector('.drp-faq-item__answer');
      var inner  = answer.querySelector('.drp-faq-item__answer-inner');
      var isOpen = item.classList.contains('is-open');

      /* Close all */
      document.querySelectorAll('.drp-faq-item.is-open').forEach(function(openItem) {
        openItem.classList.remove('is-open');
        openItem.querySelector('.drp-faq-item__trigger').setAttribute('aria-expanded', 'false');
        openItem.querySelector('.drp-faq-item__answer').style.height = '0';
      });

      /* Open clicked (if it was closed) */
      if (!isOpen) {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.height = inner.offsetHeight + 'px';
      }
    });
  });

  /* ── Scarcity fill bar animate on scroll ── */
  var fills = document.querySelectorAll('.drp-scarcity__fill');
  if ('IntersectionObserver' in window && fills.length) {
    var fillIO = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          /* width already set inline, just trigger a reflow */
          e.target.style.transition = 'width 1.2s cubic-bezier(0.16,1,0.3,1)';
          fillIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    fills.forEach(function(el) { fillIO.observe(el); });
  }

})();
</script>

