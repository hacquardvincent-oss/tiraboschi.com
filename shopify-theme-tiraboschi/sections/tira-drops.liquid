      </div>
      <div class="drp-past-row" data-reveal>
        <span class="drp-past-row__name">Drop SS25</span>
        <div class="drp-past-row__meta">
          <span class="drp-past-row__status">Complet · Livré</span>
          <span class="drp-past-row__date">Printemps 2025</span>
        </div>
      </div>
      <div class="drp-past-row" data-reveal>
        <span class="drp-past-row__name">Drop FW25</span>
        <div class="drp-past-row__meta">
          <span class="drp-past-row__status">Complet · Livré</span>
          <span class="drp-past-row__date">Automne 2025</span>
        </div>
