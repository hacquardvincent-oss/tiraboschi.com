{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Histoire — Page éditoriale "La Maison"
  ═══════════════════════════════════════════════════════════════
  Structure :
  1. Hero fond --tira-grey
  2. Intro centré max-width 720px
  3. Stats 3 colonnes fond noir
  4. Image gauche + texte droite "Le Geste Juste"
  5. Timeline 4 dates fond --tira-grey
  6. Image droite + texte gauche "Le Cuir Vivant"
  7. CTA final centré
{% endcomment %}

<style>
  /* ── Variables locales ── */
  .hist-page {
    --tira-black: #0a0a0a;
    --tira-white: #ffffff;
    --tira-grey: #f7f5f2;
    --tira-border: #e8e8e8;
    --tira-ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--tira-black);
  }

  /* ── 1. Hero ── */
  .hist-hero {
    background: var(--tira-grey);
    padding: calc(var(--content-top) + 80px) 40px 80px;
    text-align: center;
  }
  .hist-hero__eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--tira-black);
    margin: 0 0 24px;
    opacity: 0.5;
  }
  .hist-hero__title {
    font-size: 56px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    line-height: 1.1;
  }
  .hist-hero__sub {
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.6;
  }

  /* ── 2. Intro ── */
  .hist-intro {
    padding: 100px 40px;
    text-align: center;
    background: var(--tira-white);
  }
  .hist-intro__text {
    max-width: 720px;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.75;
    font-weight: 400;
  }

  /* ── 3. Stats ── */
  .hist-stats {
    background: var(--tira-black);
    color: var(--tira-white);
    padding: 80px 40px;
  }
  .hist-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    max-width: 1200px;
    margin: 0 auto;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .hist-stats__item {
    padding: 60px 40px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
  }
  .hist-stats__item:last-child {
    border-right: none;
  }
  .hist-stats__number {
    font-size: 64px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0 0 12px;
    display: block;
  }
  .hist-stats__label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 0;
  }

  /* ── 4 & 6. Sections image + texte ── */
  .hist-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 600px;
    background: var(--tira-white);
  }
  .hist-split--reverse {
    direction: rtl;
  }
  .hist-split--reverse > * {
    direction: ltr;
  }
  .hist-split__img {
    overflow: hidden;
    position: relative;
  }
  .hist-split__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hist-split__body {
    padding: 80px 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hist-split__label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.4;
    margin: 0 0 24px;
  }
  .hist-split__title {
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 28px;
    line-height: 1.15;
  }
  .hist-split__text {
    font-size: 15px;
    line-height: 1.8;
    margin: 0;
    opacity: 0.75;
  }

  /* ── 5. Timeline ── */
  .hist-timeline {
    background: var(--tira-grey);
    padding: 100px 40px;
  }
  .hist-timeline__label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.4;
    margin: 0 0 64px;
  }
  .hist-timeline__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }
  .hist-timeline__grid::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 12.5%;
    right: 12.5%;
    height: 1px;
    background: var(--tira-border);
  }
  .hist-timeline__item {
    text-align: center;
    padding: 0 20px;
    position: relative;
  }
  .hist-timeline__dot {
    width: 16px;
    height: 16px;
    border: 1px solid var(--tira-black);
    background: var(--tira-white);
    border-radius: 0;
    margin: 0 auto 24px;
    position: relative;
    z-index: 1;
  }
  .hist-timeline__year {
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.01em;
    display: block;
    margin: 0 0 12px;
  }
  .hist-timeline__event {
    font-size: 13px;
    line-height: 1.6;
    opacity: 0.6;
    margin: 0;
  }

  /* ── 7. CTA ── */
  .hist-cta {
    background: var(--tira-white);
    padding: 100px 40px;
    text-align: center;
    border-top: 1px solid var(--tira-border);
  }
  .hist-cta__link {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--tira-black);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.3s var(--tira-ease);
  }
  .hist-cta__link:hover {
    opacity: 0.5;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hist-hero {
      padding: calc(var(--content-top) + 48px) 24px 48px;
    }
    .hist-hero__title {
      font-size: 36px;
    }
    .hist-intro {
      padding: 64px 24px;
    }
    .hist-intro__text {
      font-size: 16px;
    }
    .hist-stats {
      padding: 48px 24px;
    }
    .hist-stats__grid {
      grid-template-columns: 1fr;
      border: none;
    }
    .hist-stats__item {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding: 40px 24px;
    }
    .hist-stats__item:last-child {
      border-bottom: none;
    }
    .hist-stats__number {
      font-size: 48px;
    }
    .hist-split {
      grid-template-columns: 1fr;
      direction: ltr;
    }
    .hist-split--reverse {
      direction: ltr;
    }
    .hist-split__img {
      height: 300px;
    }
    .hist-split__body {
      padding: 48px 24px;
    }
    .hist-split__title {
      font-size: 28px;
    }
    .hist-timeline {
      padding: 64px 24px;
    }
    .hist-timeline__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hist-timeline__grid::before {
      display: none;
    }
    .hist-timeline__item {
      text-align: left;
      display: flex;
      align-items: flex-start;
      gap: 20px;
      padding: 0;
    }
    .hist-timeline__dot {
      margin: 6px 0 0;
      flex-shrink: 0;
    }
    .hist-cta {
      padding: 64px 24px;
    }
  }

  /* ── Reveal animation ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s var(--tira-ease), transform 0.9s var(--tira-ease);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
</style>

<div class="hist-page">

  {%- comment -%} ═══ 1. HERO ═══ {%- endcomment -%}
  <section class="hist-hero">
    <p class="hist-hero__eyebrow" data-reveal>La Maison</p>
    <h1 class="hist-hero__title" data-reveal>La Maison</h1>
    <p class="hist-hero__sub" data-reveal>Maroquinerie de Luxe Française &middot; Depuis 1904</p>
  </section>

  {%- comment -%} ═══ 2. INTRO ═══ {%- endcomment -%}
  <section class="hist-intro">
    <p class="hist-intro__text" data-reveal>
      TIRABOSCHI Paris naît en 1904, fondée par Aldo Tiraboschi, artisan maroquinier d'origine italienne installé à Paris. Dans son atelier du 9ème arrondissement, il fabrique à la main les premières pièces — des sacs de voyage pour les grands hôtels parisiens. Cent vingt ans plus tard, la maison n'a pas changé de philosophie.
    </p>
  </section>

  {%- comment -%} ═══ 3. STATS ═══ {%- endcomment -%}
  <section class="hist-stats" aria-label="Chiffres clés">
    <div class="hist-stats__grid">
      <div class="hist-stats__item" data-reveal>
        <span class="hist-stats__number">1904</span>
        <p class="hist-stats__label">Fondée à Paris</p>
      </div>
      <div class="hist-stats__item" data-reveal>
        <span class="hist-stats__number">1</span>
        <p class="hist-stats__label">Artisan par sac, de A à Z</p>
      </div>
      <div class="hist-stats__item" data-reveal>
        <span class="hist-stats__number">3 400</span>
        <p class="hist-stats__label">Points de couture sellier</p>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 4. IMAGE + TEXTE — Le Geste Juste ═══ {%- endcomment -%}
  <section class="hist-split" aria-label="Le Geste Juste">
    <div class="hist-split__img">
      <img src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/BOSCHI0919.jpg"
           alt="Artisan TIRABOSCHI au travail"
           width="960" height="1200"
           loading="lazy">
    </div>
    <div class="hist-split__body">
      <p class="hist-split__label" data-reveal>Savoir-Faire</p>
      <h2 class="hist-split__title" data-reveal>Le Geste Juste</h2>
      <p class="hist-split__text" data-reveal>
        Chaque pièce TIRABOSCHI est façonnée par un seul artisan, du découpage du cuir à la pose de la dernière finition. Ce n'est pas une méthode de production — c'est une discipline. Celle qui permet à chaque sac de porter l'empreinte invisible de ses mains.
      </p>
    </div>
  </section>

  {%- comment -%} ═══ 5. TIMELINE ═══ {%- endcomment -%}
  <section class="hist-timeline" aria-label="Chronologie">
    <p class="hist-timeline__label" data-reveal>Chronologie</p>
    <div class="hist-timeline__grid">
      <div class="hist-timeline__item" data-reveal>
        <div class="hist-timeline__dot" aria-hidden="true"></div>
        <div>
          <span class="hist-timeline__year">1904</span>
          <p class="hist-timeline__event">Fondation de l'atelier à Paris</p>
        </div>
      </div>
      <div class="hist-timeline__item" data-reveal>
        <div class="hist-timeline__dot" aria-hidden="true"></div>
        <div>
          <span class="hist-timeline__year">1938</span>
          <p class="hist-timeline__event">Création du modèle Victoire</p>
        </div>
      </div>
      <div class="hist-timeline__item" data-reveal>
        <div class="hist-timeline__dot" aria-hidden="true"></div>
        <div>
          <span class="hist-timeline__year">1986</span>
          <p class="hist-timeline__event">Transmission à la deuxième génération</p>
        </div>
      </div>
      <div class="hist-timeline__item" data-reveal>
        <div class="hist-timeline__dot" aria-hidden="true"></div>
        <div>
          <span class="hist-timeline__year">2024</span>
          <p class="hist-timeline__event">Collection FW25 &middot; Retour aux origines</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 6. IMAGE DROITE + TEXTE GAUCHE — Le Cuir Vivant ═══ {%- endcomment -%}
  <section class="hist-split hist-split--reverse" aria-label="Le Cuir Vivant">
    <div class="hist-split__img">
      <img src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Asset_atelier_1.png"
           alt="Cuir pleine fleur TIRABOSCHI"
           width="960" height="1200"
           loading="lazy">
    </div>
    <div class="hist-split__body">
      <p class="hist-split__label" data-reveal>La Matière</p>
      <h2 class="hist-split__title" data-reveal>Le Cuir Vivant</h2>
      <p class="hist-split__text" data-reveal>
        Nous n'utilisons que du cuir pleine fleur — la couche la plus noble, la plus résistante, celle qui vieillit comme une peau. Nos tanneries partenaires travaillent en France, selon des méthodes végétales centenaires.
      </p>
    </div>
  </section>

  {%- comment -%} ═══ 7. CTA FINAL ═══ {%- endcomment -%}
  <section class="hist-cta">
    <a class="hist-cta__link" href="/pages/savoir-faire" data-reveal>
      Découvrir notre savoir-faire &rarr;
    </a>
  </section>

</div>

{% schema %}
{
  "name": "Histoire",
  "tag": "section",
  "presets": [{ "name": "Histoire — La Maison" }]
}
{% endschema %}
