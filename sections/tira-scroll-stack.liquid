{% comment %}
  TIRABOSCHI — Scroll stack 5 panneaux sticky (style Miu Miu)
  Référence : tiraboschi-homepage-prototype.html L1433-1521

  image_url_fallback : URL CDN texte par panneau — utilisée quand aucune image
  n'est sélectionnée via image_picker dans le thème editor.
{% endcomment %}

{%- assign total_panels = section.blocks.size -%}

{%- assign stack_aria = section.settings.aria_label | default: "L'univers TIRABOSCHI" -%}
<div class="stack" aria-label="{{ stack_aria | escape }}">
  {%- for block in section.blocks -%}
    {%- assign panel_num = forloop.index -%}
    {%- assign panel_num_padded = panel_num | prepend: '0' | slice: -2, 2 -%}
    {%- assign total_padded = total_panels | prepend: '0' | slice: -2, 2 -%}

    {%- comment -%} Résoudre l'image : picker > fallback url > fond noir {%- endcomment -%}
    {%- assign panel_has_img = false -%}
    {%- if block.settings.image -%}
      {%- assign panel_has_img = true -%}
    {%- elsif block.settings.image_url_fallback != blank -%}
      {%- assign panel_has_img = true -%}
    {%- endif -%}

    <div class="stack__panel stack__panel--{{ block.settings.overlay_style | default: 'dark' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.link_url != blank -%}
        <a href="{{ block.settings.link_url }}" class="stack__panel-link" aria-label="{{ block.settings.title | escape }}"></a>
      {%- endif -%}
      <div class="stack__bg">
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 1920 }}"
               srcset="{{ block.settings.image | image_url: width: 768 }} 768w,
                       {{ block.settings.image | image_url: width: 1280 }} 1280w,
                       {{ block.settings.image | image_url: width: 1920 }} 1920w"
               sizes="100vw"
               alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
               width="1920" height="1080"
               loading="eager">
        {%- elsif block.settings.image_url_fallback != blank -%}
          <img src="{{ block.settings.image_url_fallback }}"
               alt="{{ block.settings.title | escape }}"
               width="1920" height="1080"
               loading="eager"
               style="object-fit:cover;width:100%;height:100%">
        {%- endif -%}
      </div>
      <div class="stack__overlay"></div>
      <div class="stack__body">
        <p class="stack__num">{{ panel_num_padded }} / {{ total_padded }}</p>
        {%- if block.settings.title != blank -%}
          <h2 class="stack__title">{{ block.settings.title }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="stack__text">{{ block.settings.text }}</p>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a href="{{ block.settings.link_url | default: '#' }}" class="stack__link">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Scroll stack",
  "tag": "div",
  "class": "tira-section tira-section--stack",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria-label",
      "default": "L'univers TIRABOSCHI"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panneau",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Titre du panneau"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image background (thème editor)"
        },
        {
          "type": "text",
          "id": "image_url_fallback",
          "label": "URL image CDN (fallback si image picker vide)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Libellé lien"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Lien"
        },
        {
          "type": "select",
          "id": "overlay_style",
          "label": "Style overlay",
          "options": [
            { "value": "dark", "label": "Sombre" },
            { "value": "light", "label": "Clair" },
            { "value": "gradient", "label": "Dégradé" }
          ],
          "default": "dark"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scroll stack TIRABOSCHI",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "title": "L'Héritage",
            "text": "Fondée à Paris en 1904, TIRABOSCHI perpétue les gestes ancestraux de la maroquinerie d'art. Quatre générations. Une seule obsession : la pièce parfaite.",
            "link_label": "Notre histoire",
            "link_url": "/pages/histoire",
            "overlay_style": "dark"
          }
        }
      ]
    }
  ]
}
{% endschema %}
