{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Header
  ═══════════════════════════════════════════════════════════════
  Desktop : [logo gauche] [nav centrée] [account · search · bag droite]
  Mobile  : [logo 1fr] [bag] [account] [hamburger]
  Plus    : search bar sticky sous le header + drawer mobile
  Styles  : assets/tiraboschi.css + assets/tiraboschi-header.css
{% endcomment %}

{%- liquid
  assign menu = section.settings.main_menu
  assign transparent_home = section.settings.transparent_on_home
  assign hdr_classes = 'hdr'
  if transparent_home and template == 'index'
    assign hdr_classes = hdr_classes | append: ' hdr--transparent-home'
  else
    # Hors homepage : header toujours solid (logo noir sur fond blanc)
    assign hdr_classes = hdr_classes | append: ' hdr--always-solid solid'
  endif
-%}

<style>
/* ── CSS critique injecté directement dans la section (indépendant du chargement des assets) ── */
:root{--header-h:68px;--search-h:44px;}
html{overflow-x:clip!important;max-width:100vw;}
body{overflow-x:hidden!important;max-width:100vw;width:100%;}
img,video,iframe,svg,canvas{max-width:100%!important;}

/* Desktop ≥1201px : .hdr__d visible, .hdr__m caché, #hdr-search caché */
@media(min-width:1201px){
  .hdr__d{display:flex!important;}
  .hdr__m{display:none!important;}
  #hdr-search{display:none!important;}
}
/* Mobile ≤1200px : .hdr__d caché, .hdr__m visible, .hdr__search-inline caché */
@media(max-width:1200px){
  .hdr__d{display:none!important;}
  .hdr__m{display:grid!important;grid-template-columns:1fr auto auto auto;}
  .hdr__search-inline{display:none!important;}
  .mega{display:none!important;}
  .mega-backdrop{display:none!important;}
}
</style>

<header class="{{ hdr_classes }}" id="hdr" role="banner" data-transparent-home="{{ transparent_home }}">

  {%- comment -%} ═══ DESKTOP ═══ {%- endcomment -%}
  <div class="hdr__d">

    {%- comment -%} Gauche : logo + navigation {%- endcomment -%}
    <div class="hdr__left">

      {%- comment -%} Logo {%- endcomment -%}
      <div class="hdr__logo">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} — accueil">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag:
                class: 'hdr__logo-img',
                alt: shop.name,
                widths: '200,400',
                height: 22 }}
          {%- else -%}
            <img class="hdr__logo-img"
                 src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Logo_-_since_1904.png?v=1772832738"
                 alt="{{ shop.name }}" width="auto" height="22">
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} Navigation desktop avec mega-menu {%- endcomment -%}
      <nav class="hdr__nav" id="hdr-nav" aria-label="{{ 'general.navigation' | t | default: 'Navigation principale' }}">

      {%- comment -%} Groupe Collections {%- endcomment -%}
      <div class="hdr__nav-item" data-mega="collections">
        <a href="{{ routes.collections_url }}/fw25"
           class="hdr__nav-link"
           {% if request.path contains '/collections/' %} aria-current="page"{% endif %}>Collections</a>
        <div class="mega" id="mega-collections" role="region" aria-label="Menu Collections">
          <div class="mega__inner">
            <div class="mega__links">
              <a href="{{ routes.collections_url }}/fw25" class="mega__link mega__link--featured">FW25 · Automne-Hiver</a>
              <a href="{{ routes.collections_url }}/sacs" class="mega__link">Sacs</a>
              <a href="{{ routes.collections_url }}/petite-maroquinerie" class="mega__link">Petite Maroquinerie</a>
              <a href="{{ routes.collections_url }}/iconiques" class="mega__link">Iconiques</a>
              <a href="{{ routes.collections_url }}/sur-mesure-exotiques" class="mega__link">Sur Mesure · Exotiques</a>
              <a href="/pages/prochains-drops" class="mega__link">Les Prochains Drops</a>
              <div class="mega__rule"></div>
              <a href="/pages/victoire" class="mega__link">La Victoire · Icône 1908</a>
              <a href="/pages/colette" class="mega__link">La Colette · Icône 1938</a>
              <a href="/pages/rafael" class="mega__link">Le Rafael · Icône 1952</a>
            </div>
            <div class="mega__visual">
              <img src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Asset_Atelier_6.png?v=1752606862"
                   alt="Collections TIRABOSCHI" width="480" height="640" loading="lazy">
              <p class="mega__caption">FW25 · Collection Automne-Hiver</p>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Sur Mesure {%- endcomment -%}
      <div class="hdr__nav-item" data-mega="surm">
        <a href="/pages/sur-mesure" class="hdr__nav-link"
           {% if request.path contains '/pages/sur-mesure' %} aria-current="page"{% endif %}>Sur Mesure</a>
        <div class="mega" id="mega-surm" role="region" aria-label="Menu Sur Mesure">
          <div class="mega__inner">
            <div class="mega__links">
              <p class="mega__tagline">Votre sac. Votre cuir. Votre empreinte.</p>
              <a href="/pages/sur-mesure" class="mega__link mega__link--featured">Découvrir le programme</a>
              <a href="/pages/sur-mesure#rdv" class="mega__link">Prendre rendez-vous</a>
              <a href="/pages/matieres-cuirs" class="mega__link">Guide des matières</a>
            </div>
            <div class="mega__visual">
              <img src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Asset_Mains_1.png?v=1752607078"
                   alt="Sur Mesure TIRABOSCHI" width="480" height="640" loading="lazy">
              <p class="mega__caption">Atelier · Paris · Sur rendez-vous</p>
            </div>
          </div>
        </div>
      </div>

      <span class="nav-sep" aria-hidden="true"></span>

      {%- comment -%} La Maison {%- endcomment -%}
      <div class="hdr__nav-item" data-mega="maison">
        <a href="/pages/histoire" class="hdr__nav-link"
           {% if request.path contains '/pages/histoire' or request.path contains '/pages/savoir-faire' or request.path contains '/pages/matieres' %} aria-current="page"{% endif %}>La Maison</a>
        <div class="mega" id="mega-maison" role="region" aria-label="Menu La Maison">
          <div class="mega__inner">
            <div class="mega__links">
              <a href="/pages/notre-histoire" class="mega__link mega__link--featured">Notre Histoire · 1904</a>
              <a href="/pages/la-creatrice" class="mega__link">La Créatrice</a>
              <a href="/pages/savoir-faire" class="mega__link">Savoir-Faire</a>
              <a href="/pages/matieres-cuirs" class="mega__link">Matières & Cuirs</a>
              <a href="/pages/la-societe" class="mega__link">The Society</a>
              <a href="/blogs/latelier" class="mega__link">L'Atelier · Blog</a>
              <a href="/pages/entretien-reparation" class="mega__link">Entretien & Réparation</a>
              <a href="/pages/contact" class="mega__link">Contact · RDV</a>
            </div>
            <div class="mega__visual">
              <img src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Asset_atelier_1.png?v=1752606834"
                   alt="Atelier TIRABOSCHI" width="480" height="640" loading="lazy">
              <p class="mega__caption">TIRABOSCHI Paris · Fondé en 1904</p>
            </div>
          </div>
        </div>
      </div>

      </nav>

    </div>{%- comment -%} /hdr__left {%- endcomment -%}

    {%- comment -%} Search centrée dans le header (desktop uniquement) {%- endcomment -%}
    {%- if section.settings.show_search -%}
    <form class="hdr__search-inline" action="{{ routes.search_url }}" method="get" role="search" aria-label="Recherche">
      <div class="hdr__search-inline__inner">
        <input type="hidden" name="type" value="product,article,page">
        <input type="search" name="q" placeholder="Demander à Tiraboschi" aria-label="Recherche" autocomplete="off">
        <button type="submit" aria-label="Rechercher">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12,5 19,12 12,19"/>
          </svg>
        </button>
      </div>
    </form>
    {%- else -%}
    <div aria-hidden="true"></div>
    {%- endif -%}

    {%- comment -%} Overlay backdrop mega-menu {%- endcomment -%}
    <div class="mega-backdrop" id="mega-backdrop" aria-hidden="true"></div>

    {%- comment -%} Icons droite : [account] [bag] {%- endcomment -%}
    <div class="hdr__icons">
      <a href="{{ routes.account_url }}" aria-label="{% if customer %}Mon compte — {{ customer.first_name | escape }}{% else %}Se connecter{% endif %}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="7.5" r="3.5"/>
          <path d="M3.5 20c0-4.5 3.8-7 8.5-7s8.5 2.5 8.5 7"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" aria-label="Panier — {{ cart.item_count }} article{% if cart.item_count != 1 %}s{% endif %}" class="hdr__bag" data-cart-count="{{ cart.item_count }}">
        <img class="tira-bag-icon"
             src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/prpi701_1.svg?v=1769633050"
             alt="" aria-hidden="true" width="22" height="22">
        {%- if cart.item_count > 0 -%}
          <span class="hdr__bag-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- comment -%} ═══ MOBILE ═══ {%- endcomment -%}
  <div class="hdr__m" aria-label="Navigation mobile">

    <a href="{{ routes.root_url }}" class="hdr__m-logo" aria-label="{{ shop.name }} — accueil">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 360 | image_tag:
            class: 'hdr__logo-img',
            alt: shop.name,
            widths: '180,360',
            height: 18 }}
      {%- else -%}
        <img class="hdr__logo-img"
             src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Logo_-_since_1904.png?v=1772832738"
             alt="{{ shop.name }}" width="auto" height="18">
      {%- endif -%}
    </a>

    <a href="{{ routes.cart_url }}" aria-label="Panier — {{ cart.item_count }} article{% if cart.item_count != 1 %}s{% endif %}" class="hdr__bag" data-cart-count="{{ cart.item_count }}">
      <img class="tira-bag-icon"
           src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/prpi701_1.svg?v=1769633050"
           alt="" aria-hidden="true" width="22" height="22">
      {%- if cart.item_count > 0 -%}
        <span class="hdr__bag-count" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>

    <a href="{{ routes.account_url }}" aria-label="Mon compte">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="7.5" r="3.5"/>
        <path d="M3.5 20c0-4.5 3.8-7 8.5-7s8.5 2.5 8.5 7"/>
      </svg>
    </a>

    <button type="button" aria-label="Menu principal" aria-expanded="false" id="mobile-menu-btn" data-tira-menu-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="3" y1="6"  x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

{%- if section.settings.show_search -%}
  {%- comment -%} ═══ SEARCH BAR — fixe sous header ═══ {%- endcomment -%}
  <form class="hdr-search" id="hdr-search" role="search" aria-label="Recherche" action="{{ routes.search_url }}" method="get">
    <input type="hidden" name="type" value="product,article,page">

    <div class="hdr-search__field">
      <div class="hdr-search__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="10.5" cy="10.5" r="6.5"/>
          <line x1="15.5" y1="15.5" x2="21" y2="21"/>
        </svg>
      </div>

      <input type="search" name="q" placeholder="Demander à Tiraboschi" aria-label="Recherche" autocomplete="off">

      <button type="submit" class="hdr-search__submit" aria-label="Rechercher">
        <svg viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </button>
    </div>

    <div class="hdr-search__actions" aria-hidden="true">
      <a href="{{ routes.account_url }}" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="7.5" r="3.5"/>
          <path d="M3.5 20c0-4.5 3.8-7 8.5-7s8.5 2.5 8.5 7"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Panier">
        <img class="tira-bag-icon"
             src="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/prpi701_1.svg?v=1769633050"
             alt="" aria-hidden="true" width="20" height="20">
      </a>
    </div>
  </form>
{%- endif -%}

{%- comment -%} ═══ MOBILE NAV DRAWER ═══ {%- endcomment -%}
<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <div class="mobile-nav__inner" role="dialog" aria-label="Menu de navigation">
    <button type="button" class="mobile-nav__close" aria-label="Fermer le menu" data-tira-menu-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>

    <ul>
      {%- if linklists[menu].links.size > 0 -%}
        {%- for link in linklists[menu].links -%}
          {%- unless link.title contains '|sep' -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.collections_url }}/sacs">Sacs</a></li>
        <li><a href="{{ routes.collections_url }}/petite-maroquinerie">Petite Maroquinerie</a></li>
        <li><a href="{{ routes.collections_url }}/iconiques">Iconiques</a></li>
        <li><a href="{{ routes.collections_url }}/sur-mesure-exotiques">Sur Mesure</a></li>
        <li><a href="/pages/histoire">La Maison</a></li>
      {%- endif -%}

      <li class="mobile-nav__sep" aria-hidden="true"></li>

      <li>
        <a href="{{ routes.account_url }}">
          {%- if customer -%}Mon compte{%- else -%}Se connecter{%- endif -%}
        </a>
      </li>
      <li><a href="{{ routes.search_url }}">Recherche</a></li>
      <li><a href="{{ routes.cart_url }}">Panier ({{ cart.item_count }})</a></li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Header TIRABOSCHI",
  "tag": "header",
  "settings": [
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Header transparent sur la homepage",
      "default": true
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (laisser vide pour utiliser le logo CDN par défaut)"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la barre de recherche sticky",
      "default": true
    }
  ],
  "presets": [{ "name": "Header TIRABOSCHI" }]
}
{% endschema %}

<script>
(function () {
  const items    = document.querySelectorAll('.hdr__nav-item[data-mega]');
  const backdrop = document.getElementById('mega-backdrop');
  const hdrEl    = document.getElementById('hdr');
  if (!items.length || !backdrop) return;

  let closeTimer;

  function openMega(item) {
    clearTimeout(closeTimer);
    items.forEach(i => i.classList.remove('is-open'));
    item.classList.add('is-open');
    backdrop.classList.add('is-visible');
    if (hdrEl) hdrEl.classList.add('mega-open');
  }

  function closeMega() {
    closeTimer = setTimeout(() => {
      items.forEach(i => i.classList.remove('is-open'));
      backdrop.classList.remove('is-visible');
      if (hdrEl) hdrEl.classList.remove('mega-open');
    }, 220);
  }

  items.forEach(item => {
    item.addEventListener('mouseenter', () => openMega(item));
    item.addEventListener('mouseleave', closeMega);
    const mega = item.querySelector('.mega');
    if (mega) {
      mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));
      mega.addEventListener('mouseleave', closeMega);
    }
  });

  backdrop.addEventListener('mouseenter', closeMega);

  // Fermer au clic sur le backdrop
  backdrop.addEventListener('click', () => {
    items.forEach(i => i.classList.remove('is-open'));
    backdrop.classList.remove('is-visible');
    if (hdrEl) hdrEl.classList.remove('mega-open');
  });

  // Fermer au scroll
  window.addEventListener('scroll', () => {
    items.forEach(i => i.classList.remove('is-open'));
    backdrop.classList.remove('is-visible');
    if (hdrEl) hdrEl.classList.remove('mega-open');
  }, { passive: true });
})();
</script>
