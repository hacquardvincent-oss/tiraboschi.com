{% comment %}
  TIRABOSCHI — Page Mot de Passe / Coming Soon
  Landing page pour le mode password-protected Shopify.
  Objectif : créer des comptes clients avant l'ouverture.
{% endcomment %}

{%- assign vid_desktop = 'https://cdn.shopify.com/videos/c/vp/a34148cdb12a474b8ca71469bf389e47/a34148cdb12a474b8ca71469bf389e47.HD-720p-4.5Mbps-79621443.mp4' -%}
{%- assign vid_mobile  = 'https://cdn.shopify.com/videos/c/vp/1358774942114ba8966c625ffb4d90ab/1358774942114ba8966c625ffb4d90ab.HD-1080p-7.2Mbps-67848507.mp4' -%}
{%- assign vid_poster  = 'https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Asset_atelier_1.png?v=1752606834' -%}

{%- if section.settings.video_url != blank -%}
  {%- assign vid_desktop = section.settings.video_url -%}
  {%- assign vid_mobile  = section.settings.video_url -%}
{%- endif -%}
{%- if section.settings.poster_url != blank -%}
  {%- assign vid_poster = section.settings.poster_url -%}
{%- endif -%}

<style>
html, body { margin: 0; padding: 0; min-height: 100%; }
body.template-password {
  background: #0a0a0a; color: #fff;
  overflow-x: clip; font-family: 'Playfair Display', Georgia, serif;
}

/* ── Fond vidéo ── */
.pw__video-wrap {
  position: fixed; inset: 0; z-index: 0;
  pointer-events: none; overflow: hidden;
}
.pw__video {
  width: 100%; height: 100%; object-fit: cover; opacity: .4;
}
.pw__overlay {
  position: fixed; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(160deg, rgba(10,10,10,.55) 0%, rgba(10,10,10,.8) 100%);
}

/* ── Layout principal ── */
.pw {
  position: relative; z-index: 2;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr minmax(0, 420px) 1fr;
  grid-template-rows: 1fr auto;
  padding: 0;
}

/* Colonne gauche : logo + titre */
.pw__left {
  grid-column: 1; grid-row: 1;
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding: 60px 48px 80px;
  border-right: 1px solid rgba(255,255,255,.08);
}
.pw__brand {
  font-size: 10px; letter-spacing: .25em; text-transform: uppercase;
  opacity: .4; margin-bottom: 20px;
}
.pw__logo {
  font-size: clamp(18px, 2vw, 26px);
  letter-spacing: .3em; text-transform: uppercase;
  font-weight: 400; margin-bottom: 40px;
}
.pw__headline {
  font-size: clamp(56px, 7vw, 96px);
  font-style: italic; line-height: .88;
  letter-spacing: -.02em; margin: 0;
}

/* Colonne centrale : formulaire */
.pw__center {
  grid-column: 2; grid-row: 1;
  display: flex; flex-direction: column;
  justify-content: center;
  padding: 80px 48px;
}

/* Colonne droite : vide (respiration) */
.pw__right {
  grid-column: 3; grid-row: 1;
  border-left: 1px solid rgba(255,255,255,.08);
}

/* Bottom bar */
.pw__bottom {
  grid-column: 1 / -1; grid-row: 2;
  border-top: 1px solid rgba(255,255,255,.08);
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 48px;
}
.pw__bottom-copy {
  font-size: 10px; letter-spacing: .12em; opacity: .25;
  text-transform: uppercase;
}

/* ── Formulaire ── */
.pw__form-eyebrow {
  font-size: 9px; letter-spacing: .2em; text-transform: uppercase;
  opacity: .35; margin-bottom: 36px;
}

.pw__row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px;
}

.pw__field {
  border-bottom: 1px solid rgba(255,255,255,.2);
  margin-bottom: 24px; transition: border-color .2s;
}
.pw__field:focus-within { border-bottom-color: rgba(255,255,255,.65); }

.pw__field label {
  display: block; font-size: 9px; letter-spacing: .15em;
  text-transform: uppercase; opacity: .35; margin-bottom: 8px;
}

.pw__field input {
  width: 100%; border: none; background: none; outline: none;
  color: #fff; font-family: inherit; font-size: 14px;
  padding: 4px 0 12px; caret-color: #fff; box-sizing: border-box;
}
.pw__field input::placeholder { color: rgba(255,255,255,.22); }

.pw__submit {
  width: 100%; margin-top: 4px;
  background: #fff; color: #0a0a0a;
  border: none; padding: 17px;
  font-family: inherit; font-size: 10px;
  text-transform: uppercase; letter-spacing: .2em;
  cursor: pointer; transition: opacity .2s;
}
.pw__submit:hover { opacity: .88; }

.pw__legal {
  font-size: 10px; opacity: .25; line-height: 1.7;
  margin-top: 14px;
}
.pw__legal a { text-decoration: underline; text-underline-offset: 3px; color: inherit; }

/* État succès */
.pw__success {
  text-align: left; padding: 0;
}
.pw__success-check {
  width: 36px; height: 36px; margin-bottom: 24px;
  border: 1px solid rgba(255,255,255,.25);
  display: flex; align-items: center; justify-content: center;
}
.pw__success-check svg { width: 16px; height: 16px; }
.pw__success h2 {
  font-size: clamp(28px, 3vw, 42px); font-style: italic;
  margin: 0 0 16px; line-height: 1.1;
}
.pw__success p { font-size: 12px; opacity: .5; line-height: 1.75; max-width: 320px; }

/* Erreurs Shopify */
.errors { margin-bottom: 20px; }
.errors ul { list-style: none; padding: 0; margin: 0; }
.errors li { font-size: 11px; color: rgba(255,120,120,.9); letter-spacing: .05em; margin-bottom: 6px; }

/* ── Accès admin ── */
.pw__admin {
  display: flex; flex-direction: column; align-items: flex-start; gap: 0;
}
.pw__admin-toggle {
  background: none; border: none; color: rgba(255,255,255,.22);
  font-family: inherit; font-size: 9px; letter-spacing: .15em;
  text-transform: uppercase; cursor: pointer;
  display: flex; align-items: center; gap: 8px;
  padding: 0; transition: color .2s;
}
.pw__admin-toggle:hover { color: rgba(255,255,255,.5); }
.pw__admin-toggle svg { width: 10px; height: 10px; transition: transform .25s; }
.pw__admin-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

.pw__admin-panel {
  max-height: 0; overflow: hidden;
  transition: max-height .3s ease; width: 100%;
}
.pw__admin-panel.is-open { max-height: 120px; }

.pw__admin-inner {
  display: flex; gap: 12px; align-items: flex-end;
  padding-top: 16px;
}
.pw__admin-inner .pw__field { flex: 1; margin-bottom: 0; }
.pw__admin-enter {
  background: none; border: 1px solid rgba(255,255,255,.2);
  color: rgba(255,255,255,.55); font-family: inherit; font-size: 9px;
  letter-spacing: .12em; text-transform: uppercase;
  padding: 10px 16px; cursor: pointer; transition: border-color .2s, color .2s;
  white-space: nowrap; flex-shrink: 0; margin-bottom: 12px;
}
.pw__admin-enter:hover { border-color: rgba(255,255,255,.45); color: #fff; }

/* ── Mobile ── */
@media (max-width: 900px) {
  .pw {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
  }
  .pw__left {
    grid-column: 1; grid-row: 1;
    padding: 60px 24px 40px;
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,.08);
    justify-content: flex-start;
  }
  .pw__center {
    grid-column: 1; grid-row: 2;
    padding: 48px 24px 40px;
    justify-content: flex-start;
  }
  .pw__right { display: none; }
  .pw__bottom {
    grid-column: 1; grid-row: 3;
    flex-direction: column; gap: 12px;
    align-items: flex-start; padding: 20px 24px;
  }
  .pw__row { grid-template-columns: 1fr; gap: 0; }
}
</style>

<div class="pw__video-wrap" aria-hidden="true">
  <video class="pw__video" id="pw-video"
         autoplay muted loop playsinline
         poster="{{ vid_poster }}">
  </video>
</div>
<div class="pw__overlay" aria-hidden="true"></div>

<div class="pw">

  {%- comment -%} ── Colonne gauche : identité + titre ── {%- endcomment -%}
  <div class="pw__left">
    <p class="pw__brand">Paris · Depuis 1904</p>
    <p class="pw__logo">{{ shop.name }}</p>
    <h1 class="pw__headline">{{ section.settings.headline | default: 'Coming<br>Soon.' }}</h1>
  </div>

  {%- comment -%} ── Colonne centrale : formulaire ── {%- endcomment -%}
  <div class="pw__center">

    {% form 'create_customer', id: 'pw-register' %}
      {{ form.errors | default_errors }}

      {%- if form.posted_successfully? -%}
        <div class="pw__success">
          <div class="pw__success-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <polyline points="20,6 9,17 4,12"/>
            </svg>
          </div>
          <h2>Bienvenue.</h2>
          <p>Votre compte a été créé. Vous serez parmi les premiers informés de l'ouverture de l'atelier.</p>
        </div>
      {%- else -%}

        <p class="pw__form-eyebrow">{{ section.settings.form_eyebrow | default: 'Rejoindre The Society' }}</p>

        <div class="pw__row">
          <div class="pw__field">
            <label for="pw-firstname">Prénom</label>
            <input type="text" name="customer[first_name]" id="pw-firstname"
                   autocomplete="given-name">
          </div>
          <div class="pw__field">
            <label for="pw-lastname">Nom</label>
            <input type="text" name="customer[last_name]" id="pw-lastname"
                   autocomplete="family-name">
          </div>
        </div>

        <div class="pw__field">
          <label for="pw-email">Email</label>
          <input type="email" name="customer[email]" id="pw-email"
                 autocomplete="email" required>
        </div>

        <div class="pw__field">
          <label for="pw-password">Mot de passe</label>
          <input type="password" name="customer[password]" id="pw-password"
                 autocomplete="new-password" required>
        </div>

        <button type="submit" class="pw__submit">
          {{ section.settings.cta_label | default: 'Créer mon compte' }}
        </button>

        <p class="pw__legal">
          En créant votre compte, vous acceptez nos
          <a href="/pages/cgv">CGV</a> et notre
          <a href="/pages/confidentialite">politique de confidentialité</a>.
        </p>

      {%- endif -%}
    {% endform %}

  </div>

  {%- comment -%} ── Colonne droite : vide ── {%- endcomment -%}
  <div class="pw__right" aria-hidden="true"></div>

  {%- comment -%} ── Barre bas ── {%- endcomment -%}
  <div class="pw__bottom">
    <p class="pw__bottom-copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>

    {%- if section.settings.show_admin_access -%}
      <div class="pw__admin">
        <button class="pw__admin-toggle" aria-expanded="false"
                aria-controls="pw-admin-panel" id="pw-admin-btn">
          Accès administrateur
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="4,6 8,10 12,6"/>
          </svg>
        </button>
        <div class="pw__admin-panel" id="pw-admin-panel" aria-hidden="true">
          {% form 'storefront_password' %}
            <div class="pw__admin-inner">
              <div class="pw__field">
                <label for="pw-store-pass">Mot de passe du site</label>
                <input type="password" name="password" id="pw-store-pass"
                       autocomplete="current-password">
              </div>
              <button type="submit" class="pw__admin-enter">Entrer</button>
            </div>
          {% endform %}
        </div>
      </div>
    {%- endif -%}
  </div>

</div>

<script>
(function() {
  var vid = document.getElementById('pw-video');
  if (vid) {
    var mobile = window.matchMedia('(max-width: 768px)').matches;
    vid.src = mobile ? {{ vid_mobile | json }} : {{ vid_desktop | json }};
    vid.load();
  }

  var btn   = document.getElementById('pw-admin-btn');
  var panel = document.getElementById('pw-admin-panel');
  if (btn && panel) {
    btn.addEventListener('click', function() {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('is-open', !open);
      panel.setAttribute('aria-hidden', String(open));
    });
  }
})();
</script>

{% schema %}
{
  "name": "Page Coming Soon",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Titre principal",
      "default": "Coming Soon."
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Sur-titre formulaire",
      "default": "Rejoindre The Society"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libellé bouton",
      "default": "Créer mon compte"
    },
    {
      "type": "header",
      "content": "Fond vidéo"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL vidéo MP4 (remplace le CDN par défaut)"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "URL image poster (fallback)"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_admin_access",
      "label": "Afficher le lien accès administrateur",
      "default": true
    }
  ],
  "presets": [{ "name": "Page Coming Soon TIRABOSCHI" }]
}
{% endschema %}
