{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Entretien & Réparation
  ═══════════════════════════════════════════════════════════════
  Structure :
  1. Hero — 80vh, dark, Ken Burns (BOSCHI0154)
  2. Marquee — "Garantie à vie" loop
  3. Promesse — blanc, blockquote éditorial
  4. Services — gris, 6 cartes numérotées (3×2)
  5. Process — blanc, 4 étapes avec ligne
  6. Tarifs — gris, 2-col (liste blanc + garantie noir)
  7. Envoi postal — blanc, 3 étapes + CTA
  8. Formulaire — gris, form Shopify contact
{% endcomment %}

<style>
  .ent-page {
    --tira-black: #0a0a0a;
    --tira-white: #ffffff;
    --tira-grey: #f7f5f2;
    --tira-border: #e8e8e8;
    --tira-ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--tira-black);
  }

  /* ── 1. Hero ── */
  .ent-hero {
    position: relative; height: 80vh; min-height: 560px;
    overflow: hidden; background: #0a0a0a;
    margin-top: var(--content-top);
  }
  .ent-hero__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    animation: ent-kb 14s ease-in-out infinite alternate;
  }
  @keyframes ent-kb {
    from { transform: scale(1); }
    to   { transform: scale(1.07) translate(1.5%, -1%); }
  }
  .ent-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.62) 0%, rgba(0,0,0,.15) 55%, transparent 100%);
    z-index: 1;
  }
  .ent-hero__content {
    position: absolute; z-index: 2;
    bottom: 56px; left: 56px; right: 56px;
    color: var(--tira-white);
  }
  .ent-hero__label {
    font-size: 10px; text-transform: uppercase; letter-spacing: .2em;
    opacity: .6; margin-bottom: 20px;
  }
  .ent-hero__title {
    font-size: clamp(42px, 6vw, 80px);
    font-weight: 400; line-height: .95; letter-spacing: -.01em; margin-bottom: 24px;
  }
  .ent-hero__sub {
    font-size: clamp(14px, 1.5vw, 18px); opacity: .8; font-style: italic; max-width: 520px;
  }

  /* ── 2. Marquee ── */
  .ent-marquee {
    overflow: hidden;
    border-top: 1px solid var(--tira-border);
    border-bottom: 1px solid var(--tira-border);
    padding: 13px 0; background: var(--tira-white);
  }
  .ent-marquee__track {
    display: flex; width: max-content;
    animation: ent-marquee 24s linear infinite;
  }
  .ent-marquee:hover .ent-marquee__track { animation-play-state: paused; }
  @keyframes ent-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .ent-marquee__item {
    font-size: 10px; text-transform: uppercase; letter-spacing: .14em;
    white-space: nowrap; padding: 0 20px; opacity: .5;
  }

  /* ── 3. Promesse ── */
  .ent-promise { background: var(--tira-white); padding: 100px 48px; text-align: center; }
  .ent-promise__quote {
    font-size: clamp(22px, 3vw, 32px); font-style: italic; letter-spacing: -.01em;
    max-width: 780px; margin: 0 auto 52px; line-height: 1.3;
  }
  .ent-promise__body { max-width: 680px; margin: 0 auto; font-size: 14px; line-height: 1.85; opacity: .75; }
  .ent-promise__body p + p { margin-top: 24px; }

  /* ── 4. Services ── */
  .ent-services { background: var(--tira-grey); padding: 80px 48px; }
  .ent-services__heading {
    font-size: 11px; text-transform: uppercase; letter-spacing: .18em;
    opacity: .45; margin-bottom: 56px; text-align: center;
  }
  .ent-services__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; max-width: 1200px; margin: 0 auto;
  }
  .ent-svc-card {
    background: var(--tira-white); padding: 40px 36px;
    border: 1px solid var(--tira-border); transition: border-color .3s;
  }
  .ent-svc-card:hover { border-color: var(--tira-black); }
  .ent-svc-card__num {
    font-size: 10px; text-transform: uppercase; letter-spacing: .2em;
    opacity: .35; margin-bottom: 20px;
  }
  .ent-svc-card__title { font-size: 20px; font-weight: 400; margin-bottom: 16px; letter-spacing: -.01em; }
  .ent-svc-card__desc { font-size: 13px; line-height: 1.75; opacity: .7; margin-bottom: 20px; }
  .ent-svc-card__delay {
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
    opacity: .45; border-top: 1px solid var(--tira-border); padding-top: 16px;
  }

  /* ── 5. Process ── */
  .ent-process { background: var(--tira-white); padding: 100px 48px; }
  .ent-process__title {
    font-size: clamp(28px, 3vw, 40px); font-weight: 400;
    text-align: center; margin-bottom: 72px; letter-spacing: -.01em;
  }
  .ent-process__steps {
    display: grid; grid-template-columns: repeat(4, 1fr);
    max-width: 1100px; margin: 0 auto;
    position: relative;
  }
  .ent-process__steps::before {
    content: '';
    position: absolute;
    top: 20px; left: calc(12.5% + 20px); right: calc(12.5% + 20px);
    height: 1px; background: var(--tira-border); z-index: 0;
  }
  .ent-step { text-align: center; padding: 0 24px; position: relative; z-index: 1; }
  .ent-step__num {
    width: 40px; height: 40px;
    border: 1px solid var(--tira-black);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
    margin: 0 auto 28px; background: var(--tira-white);
  }
  .ent-step__name { font-size: 18px; font-weight: 400; margin-bottom: 14px; letter-spacing: -.01em; }
  .ent-step__desc { font-size: 13px; line-height: 1.75; opacity: .65; }

  /* ── 6. Tarifs ── */
  .ent-tarifs { background: var(--tira-grey); padding: 100px 48px; }
  .ent-tarifs__inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 2px; max-width: 1100px; margin: 0 auto;
  }
  .ent-tarifs__left { background: var(--tira-white); padding: 56px 52px; }
  .ent-tarifs__title {
    font-size: clamp(26px, 2.5vw, 36px); font-weight: 400; letter-spacing: -.01em; margin-bottom: 28px;
  }
  .ent-tarifs__intro { font-size: 14px; line-height: 1.8; opacity: .7; margin-bottom: 32px; }
  .ent-tarifs__list { list-style: none; border-top: 1px solid var(--tira-border); }
  .ent-tarifs__list li {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--tira-border); font-size: 13px;
  }
  .ent-tarifs__list li span:first-child { opacity: .75; }
  .ent-tarifs__list li span:last-child { font-style: italic; white-space: nowrap; margin-left: 12px; }
  .ent-tarifs__note { font-size: 12px; opacity: .5; margin-top: 24px; font-style: italic; line-height: 1.6; }
  .ent-tarifs__right {
    background: var(--tira-black); color: var(--tira-white); padding: 56px 52px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .ent-tarifs__promise-title {
    font-size: clamp(22px, 2vw, 32px); font-weight: 400; letter-spacing: -.01em; margin-bottom: 28px;
  }
  .ent-tarifs__promise-body { font-size: 14px; line-height: 1.85; opacity: .75; }

  /* ── 7. Postal ── */
  .ent-postal { background: var(--tira-white); padding: 100px 48px; text-align: center; }
  .ent-postal__title {
    font-size: clamp(28px, 3vw, 42px); font-weight: 400; letter-spacing: -.01em; margin-bottom: 28px;
  }
  .ent-postal__body {
    font-size: 14px; line-height: 1.8; opacity: .7; max-width: 560px; margin: 0 auto 48px;
  }
  .ent-postal__steps {
    display: flex; justify-content: center; gap: 56px; margin-bottom: 52px;
  }
  .ent-postal-step { text-align: center; max-width: 200px; }
  .ent-postal-step__num {
    font-size: 10px; text-transform: uppercase; letter-spacing: .2em; opacity: .35; margin-bottom: 12px;
  }
  .ent-postal-step__text { font-size: 13px; line-height: 1.7; opacity: .7; }
  .ent-postal__cta {
    font-size: 11px; text-transform: uppercase; letter-spacing: .14em;
    text-decoration: underline; text-underline-offset: 5px;
    opacity: .8; transition: opacity .2s;
  }
  .ent-postal__cta:hover { opacity: 1; }

  /* ── 8. Formulaire ── */
  .ent-form-section { background: var(--tira-grey); padding: 100px 48px; }
  .ent-form-inner { max-width: 720px; margin: 0 auto; }
  .ent-form-title {
    font-size: clamp(28px, 3vw, 42px); font-weight: 400;
    letter-spacing: -.01em; margin-bottom: 48px; text-align: center;
  }
  .ent-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; margin-bottom: 24px; }
  .ent-form-field { display: flex; flex-direction: column; gap: 8px; }
  .ent-form-field--full { grid-column: 1 / -1; }
  .ent-form-field label {
    font-size: 10px; text-transform: uppercase; letter-spacing: .15em; opacity: .5;
  }
  .ent-form-field input,
  .ent-form-field select,
  .ent-form-field textarea {
    font-family: inherit; font-size: 14px; background: none;
    border: none; border-bottom: 1px solid var(--tira-border);
    padding: 10px 0; outline: none; color: var(--tira-black);
    transition: border-color .25s; -webkit-appearance: none; appearance: none; width: 100%;
  }
  .ent-form-field input:focus,
  .ent-form-field select:focus,
  .ent-form-field textarea:focus { border-bottom-color: var(--tira-black); }
  .ent-form-field textarea { resize: none; min-height: 100px; line-height: 1.7; }
  .ent-form-radio { display: flex; gap: 32px; margin-top: 4px; }
  .ent-form-radio label {
    display: flex; align-items: center; gap: 8px; font-size: 13px; opacity: .75;
    cursor: pointer; text-transform: none; letter-spacing: 0;
  }
  .ent-form-radio input[type="radio"] { accent-color: var(--tira-black); }
  .ent-form-submit { margin-top: 40px; text-align: center; }
  .ent-form-submit button {
    font-family: inherit; font-size: 13px; text-transform: uppercase; letter-spacing: .12em;
    text-decoration: underline; text-underline-offset: 3px;
    background: none; border: none; padding: 0; cursor: pointer;
    color: var(--tira-black); transition: opacity .2s;
  }
  .ent-form-submit button:hover { opacity: .5; }
  .ent-form-success {
    padding: 24px; border: 1px solid var(--tira-border);
    font-size: 14px; opacity: .7; font-style: italic; line-height: 1.7;
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .ent-services__grid { grid-template-columns: 1fr; }
    .ent-services { padding: 56px 24px; }
    .ent-process__steps { grid-template-columns: 1fr; gap: 40px; }
    .ent-process__steps::before { display: none; }
    .ent-process { padding: 72px 24px; }
    .ent-tarifs__inner { grid-template-columns: 1fr; }
    .ent-tarifs { padding: 56px 24px; }
    .ent-tarifs__left, .ent-tarifs__right { padding: 40px 28px; }
    .ent-form-row { grid-template-columns: 1fr; }
    .ent-form-section { padding: 72px 24px; }
  }
  @media (max-width: 768px) {
    .ent-hero__content { bottom: 36px; left: 24px; right: 24px; }
    .ent-promise { padding: 72px 24px; }
    .ent-postal__steps { flex-direction: column; align-items: center; gap: 32px; }
    .ent-postal { padding: 72px 24px; }
  }
</style>

<div class="ent-page">

  {%- comment -%} ── 1. HERO ── {%- endcomment -%}
  <section class="ent-hero" aria-label="Entretien et Réparation TIRABOSCHI Paris">
    <img class="ent-hero__img"
         src="{{ 'https://cdn.shopify.com/s/files/1/0927/5890/1079/files/BOSCHI0154.jpg' }}"
         alt="Atelier TIRABOSCHI Paris" fetchpriority="high" loading="eager"
         width="1920" height="1280">
    <div class="ent-hero__overlay"></div>
    <div class="ent-hero__content">
      <p class="ent-hero__label">Bilan gratuit sur rendez-vous · Devis sous 48h</p>
      <h1 class="ent-hero__title" data-words>Entretien &amp; Réparation</h1>
      <p class="ent-hero__sub">Une pièce TIRABOSCHI est garantie à vie, si elle est aimée.</p>
    </div>
  </section>

  {%- comment -%} ── 2. MARQUEE ── {%- endcomment -%}
  <div class="ent-marquee" aria-hidden="true">
    <div class="ent-marquee__track">
      <span class="ent-marquee__item">Made in France, Only.</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Since 1904</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Garantie à vie</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Atelier Paris</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Réparation Sellier</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Made in France, Only.</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Since 1904</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Garantie à vie</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Atelier Paris</span>
      <span class="ent-marquee__item">·</span>
      <span class="ent-marquee__item">Réparation Sellier</span>
      <span class="ent-marquee__item">·</span>
    </div>
  </div>

  {%- comment -%} ── 3. PROMESSE ── {%- endcomment -%}
  <section class="ent-promise">
    <blockquote class="ent-promise__quote" data-reveal>
      "Nous réparons ce que nous fabriquons. Sans limitation de date."
    </blockquote>
    <div class="ent-promise__body" data-reveal>
      <p>Quand vous achetez une pièce TIRABOSCHI, vous achetez aussi l'engagement de l'atelier qui l'a créée. Chaque sac est fabriqué par un artisan dont le nom figure dans le carnet de bord de l'atelier. Ce même artisan — ou son successeur formé par lui — peut rouvrir, réparer, recoudre, reteindre.</p>
      <p>Nous ne proposons pas de service après-vente. Nous proposons une continuation.</p>
    </div>
  </section>

  {%- comment -%} ── 4. SERVICES ── {%- endcomment -%}
  <section class="ent-services" aria-label="Services d'atelier">
    <p class="ent-services__heading" data-reveal>Services d'atelier</p>
    <div class="ent-services__grid">

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">01</div>
        <h3 class="ent-svc-card__title">Nettoyage &amp; Conditionnement</h3>
        <p class="ent-svc-card__desc">Nettoyage à sec en profondeur, application de crème nourrissante naturelle, lustrage à la main pour raviver l'éclat du cuir.</p>
        <p class="ent-svc-card__delay">Délai estimé : 5 jours ouvrés</p>
      </div>

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">02</div>
        <h3 class="ent-svc-card__title">Recouture Sellier</h3>
        <p class="ent-svc-card__desc">Remplacement du fil sur tout ou partie des coutures sellier au point de selle, à l'identique de la couture d'origine.</p>
        <p class="ent-svc-card__delay">Délai estimé : 7–10 jours ouvrés</p>
      </div>

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">03</div>
        <h3 class="ent-svc-card__title">Recoloriage</h3>
        <p class="ent-svc-card__desc">Reteinture à l'eau dans la couleur d'origine référencée en atelier, ou nouvelle teinte au choix du client. Finition à la main.</p>
        <p class="ent-svc-card__delay">Délai estimé : 10–14 jours ouvrés</p>
      </div>

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">04</div>
        <h3 class="ent-svc-card__title">Remplacement Quincaillerie</h3>
        <p class="ent-svc-card__desc">Fermoir, passants, anneaux D, chaîne dorée ou argentée — remplacement avec pièces identiques ou compatibles issues du stock atelier.</p>
        <p class="ent-svc-card__delay">Délai estimé : 5–7 jours ouvrés</p>
      </div>

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">05</div>
        <h3 class="ent-svc-card__title">Réfection Doublure</h3>
        <p class="ent-svc-card__desc">Remplacement complet de la doublure agneau intérieure, couture à la main, dans le tissu ou cuir d'origine du modèle concerné.</p>
        <p class="ent-svc-card__delay">Délai estimé : 14–21 jours ouvrés</p>
      </div>

      <div class="ent-svc-card" data-reveal>
        <div class="ent-svc-card__num">06</div>
        <h3 class="ent-svc-card__title">Révision Complète</h3>
        <p class="ent-svc-card__desc">Évaluation globale de l'état de la pièce, suivi de l'ensemble des interventions nécessaires. L'artisan signe à nouveau le passeport.</p>
        <p class="ent-svc-card__delay">Devis personnalisé</p>
      </div>

    </div>
  </section>

  {%- comment -%} ── 5. PROCESS ── {%- endcomment -%}
  <section class="ent-process" aria-label="Comment ça fonctionne">
    <h2 class="ent-process__title" data-reveal>Comment ça fonctionne</h2>
    <div class="ent-process__steps">

      <div class="ent-step" data-reveal>
        <div class="ent-step__num">01</div>
        <h3 class="ent-step__name">Le Bilan</h3>
        <p class="ent-step__desc">Apportez ou envoyez votre pièce à l'atelier. Diagnostic gratuit, réalisé par notre artisan dans les 24h suivant la réception.</p>
      </div>

      <div class="ent-step" data-reveal>
        <div class="ent-step__num">02</div>
        <h3 class="ent-step__name">Le Devis</h3>
        <p class="ent-step__desc">Vous recevez le devis détaillé sous 48h. Tarifs clairs selon l'intervention. Aucun engagement avant votre validation.</p>
      </div>

      <div class="ent-step" data-reveal>
        <div class="ent-step__num">03</div>
        <h3 class="ent-step__name">La Réparation</h3>
        <p class="ent-step__desc">Délai convenu, respecté. Vous suivez l'avancement par email. À la fin, l'artisan signe à nouveau dans le passeport de la pièce.</p>
      </div>

      <div class="ent-step" data-reveal>
        <div class="ent-step__num">04</div>
        <h3 class="ent-step__name">Le Retour</h3>
        <p class="ent-step__desc">Livraison avec un pochon neuf. Une attestation d'entretien est glissée dans le passeport de la pièce pour en tracer l'histoire.</p>
      </div>

    </div>
  </section>

  {%- comment -%} ── 6. TARIFS ── {%- endcomment -%}
  <section class="ent-tarifs" aria-label="Tarifs d'entretien et réparation">
    <div class="ent-tarifs__inner">
      <div class="ent-tarifs__left" data-reveal>
        <h2 class="ent-tarifs__title">Tarifs</h2>
        <p class="ent-tarifs__intro">Nos tarifs sont établis au cas par cas, selon l'état réel de la pièce et l'intervention nécessaire. À titre indicatif :</p>
        <ul class="ent-tarifs__list">
          <li><span>Nettoyage &amp; conditionnement</span><span>80–120€</span></li>
          <li><span>Recouture partielle</span><span>150–250€</span></li>
          <li><span>Recouture complète</span><span>350–500€</span></li>
          <li><span>Recoloriage</span><span>200–300€</span></li>
          <li><span>Remplacement quincaillerie</span><span>120–280€</span></li>
          <li><span>Réfection doublure</span><span>280–450€</span></li>
          <li><span>Révision complète</span><span>Sur devis</span></li>
        </ul>
        <p class="ent-tarifs__note">Les pièces hors d'âge ou très endommagées sont estimées gratuitement avant tout engagement de votre part.</p>
      </div>
      <div class="ent-tarifs__right" data-reveal>
        <h3 class="ent-tarifs__promise-title">Garantie à vie</h3>
        <p class="ent-tarifs__promise-body">Toute pièce TIRABOSCHI entretenue dans notre atelier bénéficie d'une garantie à vie sur le travail réalisé. Aucune date limite, aucun ticket de caisse nécessaire — nous retrouvons votre pièce dans nos archives grâce à son numéro de passeport.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ── 7. ENVOI POSTAL ── {%- endcomment -%}
  <section class="ent-postal" aria-label="Envoi postal pour réparation">
    <h2 class="ent-postal__title" data-reveal>Vous n'êtes pas à Paris ?</h2>
    <p class="ent-postal__body" data-reveal>
      Vous pouvez nous confier votre pièce par voie postale depuis n'importe où en France.
      Nous prenons en charge les frais de retour une fois la réparation effectuée.
    </p>
    <div class="ent-postal__steps" data-reveal>
      <div class="ent-postal-step">
        <div class="ent-postal-step__num">Étape 1</div>
        <p class="ent-postal-step__text">Contactez-nous par email avec quelques photos de votre pièce</p>
      </div>
      <div class="ent-postal-step">
        <div class="ent-postal-step__num">Étape 2</div>
        <p class="ent-postal-step__text">Nous vous envoyons une étiquette d'expédition prépayée</p>
      </div>
      <div class="ent-postal-step">
        <div class="ent-postal-step__num">Étape 3</div>
        <p class="ent-postal-step__text">Diagnostic et devis dans les 48h après réception en atelier</p>
      </div>
    </div>
    <a href="mailto:atelier@tiraboschi-paris.com" class="ent-postal__cta" data-reveal>
      Initier une réparation par courrier →
    </a>
  </section>

  {%- comment -%} ── 8. FORMULAIRE ── {%- endcomment -%}
  <section class="ent-form-section" id="ent-form" aria-label="Demander un bilan entretien">
    <div class="ent-form-inner">
      <h2 class="ent-form-title" data-reveal>Demander un bilan</h2>

      {%- form 'contact', id: 'ent-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="ent-form-success" role="status">
            Votre demande a bien été envoyée — nous vous répondrons sous 48h ouvrées.
          </p>
        {%- endif -%}
        {{ form.errors | default_errors }}
        <div class="ent-form-row">
          <div class="ent-form-field">
            <label for="ent-prenom">Prénom</label>
            <input type="text" id="ent-prenom" name="contact[prenom]" autocomplete="given-name">
          </div>
          <div class="ent-form-field">
            <label for="ent-nom">Nom</label>
            <input type="text" id="ent-nom" name="contact[nom]" autocomplete="family-name">
          </div>
          <div class="ent-form-field">
            <label for="ent-email">Email *</label>
            <input type="email" id="ent-email" name="contact[email]" autocomplete="email" required>
          </div>
          <div class="ent-form-field">
            <label for="ent-tel">Téléphone</label>
            <input type="tel" id="ent-tel" name="contact[telephone]" autocomplete="tel">
          </div>
          <div class="ent-form-field">
            <label for="ent-modele">Modèle</label>
            <select id="ent-modele" name="contact[modele]">
              <option value="">Choisir un modèle</option>
              <option>Victoire</option>
              <option>Colette</option>
              <option>Colette Mini</option>
              <option>Rafael</option>
              <option>Jane</option>
              <option>Olympe</option>
              <option>Pochon</option>
              <option>Autre</option>
            </select>
          </div>
          <div class="ent-form-field">
            <label>Préférence</label>
            <div class="ent-form-radio">
              <label><input type="radio" name="contact[preference]" value="En atelier" checked> En atelier</label>
              <label><input type="radio" name="contact[preference]" value="Par courrier"> Par courrier</label>
            </div>
          </div>
          <div class="ent-form-field ent-form-field--full">
            <label for="ent-desc">Description du problème *</label>
            <textarea id="ent-desc" name="contact[body]" rows="4"
                      placeholder="Décrivez l'état de la pièce et ce qui vous préoccupe…" required></textarea>
          </div>
        </div>
        <div class="ent-form-submit">
          <button type="submit">Envoyer ma demande →</button>
        </div>
      {%- endform -%}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Entretien & Réparation",
  "tag": "section",
  "class": "tira-section tira-section--entretien",
  "settings": [],
  "presets": [
    {
      "name": "Entretien & Réparation"
    }
  ]
}
{% endschema %}
