{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Fiche produit
  ═══════════════════════════════════════════════════════════════
  Desktop : galerie scroll vertical sticky + panneau info
  Mobile  : galerie scroll vertical full-width (style Miu Miu)
            → dots indicateur + wishlist fixed
            → info compacte + panel "Détails du produit"
            → sticky ATC plein-écran en bas
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign composition = product.metafields.custom.composition.value | default: ''
  assign fabrication  = product.metafields.custom.fabrication.value | default: ''
  assign contenances  = product.metafields.custom.contenances.value | default: ''
  assign dimensions   = product.metafields.custom.dimensions.value | default: ''
  assign is_preorder  = false
  if product.tags contains 'preorder'
    assign is_preorder = true
  endif
-%}

{%- if customer -%}<script>window.TIRA_SHOW_PRICE=true;</script>{%- endif -%}

{%- comment -%}
  ═══ HERO PLEIN ÉCRAN — première image, infos en surimpression ═══
  Le header passe en transparent au-dessus (data-tira-dark-hero).
  Au scroll, les visuels de la pièce s'enchaînent (moment 02), puis on
  retombe sur la mise en page classique.
{%- endcomment -%}
{%- assign use_hero = section.settings.fullscreen_hero -%}
{%- if product.images.size == 0 -%}{%- assign use_hero = false -%}{%- endif -%}

{%- if use_hero -%}
  {%- assign hero_img = product.featured_image | default: product.images[0] -%}
  <link rel="preload" as="image"
        href="{{ hero_img | image_url: width: 1600 }}"
        imagesrcset="{{ hero_img | image_url: width: 900 }} 900w,
                     {{ hero_img | image_url: width: 1600 }} 1600w,
                     {{ hero_img | image_url: width: 2200 }} 2200w"
        imagesizes="100vw">

  <section class="prd-hero" id="prd-hero" data-tira-dark-hero
           aria-label="{{ product.title | escape }}">
    <div class="prd-hero__sticky">

      <div class="prd-hero__frames" id="prd-hero-frames">
        {%- for image in product.images limit: 5 -%}
          <div class="prd-hero__frame{% if forloop.first %} on{% endif %}">
            <img src="{{ image | image_url: width: 1600 }}"
                 srcset="{{ image | image_url: width: 900 }} 900w,
                         {{ image | image_url: width: 1600 }} 1600w,
                         {{ image | image_url: width: 2200 }} 2200w"
                 sizes="100vw"
                 alt="{% if forloop.first %}{{ image.alt | default: product.title | escape }}{% endif %}"
                 width="1600" height="2000"
                 {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          </div>
        {%- endfor -%}
      </div>

      <div class="prd-hero__veil" aria-hidden="true"></div>

      <div class="prd-hero__content">
        <p class="prd-hero__ref">
          {%- if collection -%}{{ collection.title }} · {% endif -%}
          FW25 · {{ product.metafields.custom.piece_number.value | default: product.type }}
        </p>
        <h1 class="prd-hero__name">{{ product.title }}</h1>
        {%- if contenances != blank -%}
          <p class="prd-hero__line">{{ contenances | truncate: 90 }}</p>
        {%- elsif product.type != blank -%}
          <p class="prd-hero__line">{{ product.type }} · Façonné à la main, Paris</p>
        {%- endif -%}
        <p class="prd-hero__price">
          {%- if customer -%}{{ current_variant.price | money }}{%- else -%}Prix sur demande{%- endif -%}
        </p>
      </div>

      {%- if product.images.size > 1 -%}
        <p class="prd-hero__count" id="prd-hero-count" aria-hidden="true">01</p>
        <div class="prd-hero__progress" aria-hidden="true"><i id="prd-hero-bar"></i></div>
      {%- endif -%}

      <div class="prd-hero__cue" aria-hidden="true">
        <span>Découvrir</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <line x1="12" y1="4" x2="12" y2="19"/><polyline points="6,13 12,19 18,13"/>
        </svg>
      </div>
    </div>
  </section>
{%- endif -%}

<div class="prd-main{% if use_hero %} prd-main--after-hero{% endif %}" id="MainContent-product">

  {%- comment -%} ─── GALERIE DESKTOP scroll vertical ─── {%- endcomment -%}
  <div class="prd-gallery" id="prd-gallery" aria-label="Galerie produit {{ product.title | escape }}">
    {%- for image in product.images -%}
      <div class="prd-gallery__img" data-img="{{ forloop.index0 }}">
        <img src="{{ image | image_url: width: 900 }}"
             srcset="{{ image | image_url: width: 600 }} 600w,
                     {{ image | image_url: width: 900 }} 900w,
                     {{ image | image_url: width: 1200 }} 1200w"
             sizes="50vw"
             alt="{{ image.alt | default: product.title | escape }}"
             width="900" height="1200"
             {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
      </div>
    {%- else -%}
      <div class="prd-gallery__img" data-img="0">
        <img src="{{ product.featured_image | image_url: width: 900 }}"
             alt="{{ product.title | escape }}"
             width="900" height="1200"
             loading="eager">
      </div>
    {%- endfor -%}
    {%- if collection -%}
      <nav class="prd-nav" aria-label="Navigation dans la collection">
        {%- if collection.previous_product -%}
          <a href="{{ collection.previous_product }}" class="prd-nav__prev" aria-label="Produit précédent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
            <span>Précédent</span>
          </a>
        {%- endif -%}
        {%- if collection.next_product -%}
          <a href="{{ collection.next_product }}" class="prd-nav__next" aria-label="Produit suivant">
            <span>Suivant</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>

  {%- comment -%} ─── GALERIE MOBILE scroll vertical (style Miu Miu) ─── {%- endcomment -%}
  <div class="prd-gallery--mobile" id="gallery-mobile" aria-label="Galerie {{ product.title | escape }}">
    <div class="prd-vgallery" id="prd-vgallery">
      {%- for image in product.images -%}
        <div class="prd-vgallery__img" id="vimg-{{ forloop.index0 }}">
          <img src="{{ image | image_url: width: 800 }}"
               srcset="{{ image | image_url: width: 480 }} 480w,
                       {{ image | image_url: width: 800 }} 800w"
               sizes="100vw"
               alt="{{ image.alt | default: product.title | escape }}"
               width="800" height="1067"
               {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
        </div>
      {%- else -%}
        <div class="prd-vgallery__img" id="vimg-0">
          <img src="{{ product.featured_image | image_url: width: 800 }}"
               alt="{{ product.title | escape }}"
               width="800" height="1067"
               loading="eager">
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ─── PANNEAU INFOS ─── {%- endcomment -%}
  <div class="prd-info" id="prd-info">

    {%- comment -%} ─── Référence catalogue muséale ─── {%- endcomment -%}
    <div class="prd-catalogue-ref">
      <a href="{{ collection.url | default: routes.collections_url }}" class="prd-catalogue-ref__back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="14" height="14"><polyline points="15,18 9,12 15,6"/></svg>
        {%- if collection -%}{{ collection.title }}{%- else -%}Collection{%- endif -%}
      </a>
      <span class="prd-catalogue-ref__num">FW25 · {{ product.metafields.custom.piece_number.value | default: product.type }}</span>
    </div>

    {%- comment -%}
      Un seul <h1> par page : le hero le porte déjà quand il est actif.
    {%- endcomment -%}
    {%- if use_hero -%}
      <p class="prd-name">{{ product.title }}</p>
    {%- else -%}
      <h1 class="prd-name">{{ product.title }}</h1>
    {%- endif -%}

    {%- comment -%} ─── Prix — visible uniquement clients connectés ─── {%- endcomment -%}
    {%- if customer -%}
      <p class="prd-price" id="prd-price-display">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="prd-price--sale">{{ current_variant.price | money }}</span>
          <span class="prd-price--compare">{{ current_variant.compare_at_price | money }}</span>
        {%- else -%}
          {{ current_variant.price | money }}
        {%- endif -%}
      </p>
    {%- else -%}
      <p class="prd-price prd-price--on-request" id="prd-price-display">Prix sur demande</p>
      <a class="prd-price__contact" href="/pages/contact?ref=prix&amp;piece={{ product.handle }}">Contacter la maison →</a>
    {%- endif -%}

    {%- if product.variants.size > 1 -%}
      <div class="prd-colors">
        <div class="prd-colors__meta">
          <span class="prd-colors__type">Matière</span>
          <span class="prd-colors__current" id="prd-variant-title">{{ current_variant.title }}</span>
        </div>

        {%- comment -%} Inputs cachés — pour le formulaire + JS sync {%- endcomment -%}
        <div id="prd-swatches" aria-hidden="true" style="display:none">
          {%- for variant in product.variants -%}
            {%- comment -%} Index de l'image de la variante dans product.images {%- endcomment -%}
            {%- assign v_img_idx = -1 -%}
            {%- if variant.image -%}
              {%- for img in product.images -%}
                {%- if img.id == variant.image.id -%}
                  {%- assign v_img_idx = forloop.index0 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            <input type="radio"
                   name="variant"
                   value="{{ variant.id }}"
                   data-variant-id="{{ variant.id }}"
                   data-variant-title="{{ variant.title | escape }}"
                   data-variant-price="{%- if customer -%}{{ variant.price | money }}{%- else -%}—{%- endif -%}"
                   data-variant-compare="{%- if customer and variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}"
                   data-variant-imgidx="{{ v_img_idx }}"
                   {% if variant.id == current_variant.id %}checked{% endif %}
                   {% unless variant.available %}disabled{% endunless %}>
          {%- endfor -%}
        </div>

        {%- comment -%} Cover Flow — style iPod {%- endcomment -%}
        <div class="prd-coverflow" id="prd-coverflow" role="listbox" aria-label="Choisir une matière">
          <button class="prd-coverflow__nav" id="prd-coverflow-prev" aria-label="Matière précédente" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
          </button>
          <div class="prd-coverflow__stage" id="prd-coverflow-stage">
            {%- for variant in product.variants -%}
              {%- assign v_lc = variant.title | downcase -%}
              {%- if v_lc contains 'noir' -%}{%- assign sw_color = '#1a1a1a' -%}
              {%- elsif v_lc contains 'blanc' -%}{%- assign sw_color = '#f0ede8' -%}
              {%- elsif v_lc contains 'crème' or v_lc contains 'creme' -%}{%- assign sw_color = '#f0ead8' -%}
              {%- elsif v_lc contains 'caramel' -%}{%- assign sw_color = '#bf7b3c' -%}
              {%- elsif v_lc contains 'cognac' -%}{%- assign sw_color = '#9b3b2a' -%}
              {%- elsif v_lc contains 'bordeaux' -%}{%- assign sw_color = '#6e2639' -%}
              {%- elsif v_lc contains 'rouge' -%}{%- assign sw_color = '#b52535' -%}
              {%- elsif v_lc contains 'marine' -%}{%- assign sw_color = '#1e3b5e' -%}
              {%- elsif v_lc contains 'bleu' or v_lc contains 'blue' -%}{%- assign sw_color = '#2c5f8a' -%}
              {%- elsif v_lc contains 'vert' or v_lc contains 'green' -%}{%- assign sw_color = '#2d5a3d' -%}
              {%- elsif v_lc contains 'kaki' or v_lc contains 'olive' -%}{%- assign sw_color = '#6b7c45' -%}
              {%- elsif v_lc contains 'brun' or v_lc contains 'marron' -%}{%- assign sw_color = '#5c3d2e' -%}
              {%- elsif v_lc contains 'chocolat' -%}{%- assign sw_color = '#3d1c1a' -%}
              {%- elsif v_lc contains 'taupe' -%}{%- assign sw_color = '#8b7b6b' -%}
              {%- elsif v_lc contains 'gris' or v_lc contains 'grey' -%}{%- assign sw_color = '#888888' -%}
              {%- elsif v_lc contains 'beige' -%}{%- assign sw_color = '#d4c4a8' -%}
              {%- elsif v_lc contains 'naturel' or v_lc contains 'natur' -%}{%- assign sw_color = '#c8a97a' -%}
              {%- elsif v_lc contains 'ivoire' or v_lc contains 'ivory' -%}{%- assign sw_color = '#f5f0e8' -%}
              {%- elsif v_lc contains 'miel' -%}{%- assign sw_color = '#d4904a' -%}
              {%- elsif v_lc contains 'sable' -%}{%- assign sw_color = '#d4b896' -%}
              {%- elsif v_lc contains 'nuit' -%}{%- assign sw_color = '#1a1f3a' -%}
              {%- elsif v_lc contains 'framboise' -%}{%- assign sw_color = '#9c2a5a' -%}
              {%- else -%}{%- assign sw_color = '#c8a97a' -%}
              {%- endif -%}
              <div class="prd-coverflow__card{% if variant.id == current_variant.id %} is-center{% endif %}"
                   data-variant-id="{{ variant.id }}"
                   data-index="{{ forloop.index0 }}"
                   role="option"
                   aria-selected="{{ variant.id == current_variant.id }}"
                   {% unless variant.available %}aria-disabled="true"{% endunless %}>
                <div class="prd-coverflow__color" style="background:{{ sw_color }};"></div>
                <span class="prd-coverflow__label">{{ variant.title | split: ' / ' | last }}</span>
                {%- unless variant.available -%}
                  <span class="prd-coverflow__sold">Épuisé</span>
                {%- endunless -%}
              </div>
            {%- endfor -%}
          </div>
          <button class="prd-coverflow__nav" id="prd-coverflow-next" aria-label="Matière suivante" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if dimensions != blank -%}
      <div class="prd-dims">
        <p class="prd-dims__label">Dimensions</p>
        <div class="prd-dims__row">
          {%- assign dim_parts = dimensions | split: '×' -%}
          {%- for dim in dim_parts -%}
            <span class="prd-dims__val">{{ dim | strip }}</span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if contenances != blank -%}
      <p class="prd-contenances">{{ contenances }}</p>
    {%- endif -%}

    {%- comment -%} ─── ATC / PRÉCOMMANDE ─── {%- endcomment -%}
    <div class="prd-atc-wrap">
      {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="prd-variant-input">
        {%- if is_preorder -%}
          <button class="prd-atc__btn--preorder" type="submit" name="add">
            Réserver ma pièce →
            {%- if product.metafields.custom.drop_edition_size -%}
              <span class="prd-atc__preorder-note">{{ product.metafields.custom.drop_name.value }} · {{ product.metafields.custom.drop_edition_size.value }} exemplaires</span>
            {%- else -%}
              <span class="prd-atc__preorder-note">Édition limitée</span>
            {%- endif -%}
          </button>
        {%- elsif current_variant.available -%}
          <button class="prd-atc" type="submit" name="add" id="atc-btn" aria-live="polite">Ajouter au panier</button>
        {%- else -%}
          <button class="prd-atc prd-atc--unavailable" type="button" disabled>Épuisé</button>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- comment -%} ─── TRIGGER DÉTAILS (mobile uniquement) ─── {%- endcomment -%}
    <button class="prd-details-trigger" id="prd-details-trigger" aria-expanded="false" aria-controls="prd-details-panel">
      Détails du produit
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9,18 15,12 9,6"/></svg>
    </button>

    {%- comment -%} ─── TRUST SIGNALS (desktop only — masqués mobile → panel) ─── {%- endcomment -%}
    <div class="prd-trust">
      <div class="prd-trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Fabriqué en France · Ateliers Paris
      </div>
      <div class="prd-trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Délai de fabrication : 4 à 6 semaines
      </div>
      <div class="prd-trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Livraison offerte · Retour 30 jours
      </div>
      <div class="prd-trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Emballage cadeau · Gravure sur demande
      </div>
    </div>

    {%- comment -%} ─── ACCORDÉONS (desktop only — masqués mobile → panel) ─── {%- endcomment -%}
    <div class="prd-accordion" id="prd-accordion">
      <div class="prd-accordion__item">
        <button class="prd-accordion__btn" aria-expanded="false">
          Composition &amp; Matière
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="2,4 6,8 10,4"/></svg>
        </button>
        <div class="prd-accordion__body">
          {%- if composition != blank -%}
            <p>{{ composition }}</p>
          {%- else -%}
            <p>Extérieur : veau grainé pleine fleur, tanné végétal. Doublure : chevreau naturel. Ferrures : laiton massif brossé. Coutures : fil polyester ciré, point sellier.</p>
          {%- endif -%}
        </div>
      </div>
      <div class="prd-accordion__item">
        <button class="prd-accordion__btn" aria-expanded="false">
          Entretien
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="2,4 6,8 10,4"/></svg>
        </button>
        <div class="prd-accordion__body">
          <ul>
            <li>Nettoyage : chiffon doux légèrement humide</li>
            <li>Hydratation : crème incolore pour cuir lisse, 2× / an</li>
            <li>Stockage : pochon en flanelle fourni, debout</li>
            <li>Éviter : pluie prolongée, chaleur directe, solvants</li>
          </ul>
        </div>
      </div>
      <div class="prd-accordion__item">
        <button class="prd-accordion__btn" aria-expanded="false">
          Livraison &amp; Retours
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="2,4 6,8 10,4"/></svg>
        </button>
        <div class="prd-accordion__body">
          <p>Livraison offerte en France métropolitaine. Colissimo Suivi ou UPS Express. Délai d'expédition : 24h ouvrées après fabrication.</p>
          <p>Retour gratuit sous 30 jours, pièce non utilisée dans son emballage d'origine.</p>
        </div>
      </div>
    </div>

  </div>{%- comment -%}/prd-info{%- endcomment -%}
</div>{%- comment -%}/prd-main{%- endcomment -%}

{%- comment -%} ─── DOTS INDICATEUR galerie mobile (fixed) ─── {%- endcomment -%}
<div class="prd-vdots" id="prd-vdots" aria-hidden="true">
  {%- for image in product.images -%}
    <span class="prd-vdot{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}"></span>
  {%- else -%}
    <span class="prd-vdot active" data-idx="0"></span>
  {%- endfor -%}
</div>

{%- comment -%} ─── WISHLIST mobile (fixed, pendant galerie) ─── {%- endcomment -%}
<button class="prd-gallery__wish" id="prd-gallery-wish"
        aria-label="Ajouter {{ product.title | escape }} aux favoris"
        data-product-id="{{ product.id }}">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
  </svg>
</button>

{%- comment -%} ─── PANEL "DÉTAILS DU PRODUIT" (mobile bottom sheet) ─── {%- endcomment -%}
<div class="prd-details-panel" id="prd-details-panel" role="dialog" aria-modal="true" aria-label="Détails du produit">
  <div class="prd-details-panel__backdrop" id="prd-details-backdrop"></div>
  <div class="prd-details-panel__inner">
    <div class="prd-details-panel__head">
      <h2>Détails du produit</h2>
      <button class="prd-details-panel__close" id="prd-details-close" aria-label="Fermer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/></svg>
      </button>
    </div>
    <div class="prd-details-panel__body">
      {%- if product.description != blank -%}
        <div class="prd-details-panel__desc">{{ product.description }}</div>
      {%- else -%}
        {%- if composition != blank or fabrication != blank -%}
          <div class="prd-details-panel__desc">
            {%- if fabrication != blank -%}<p>{{ fabrication }}</p>{%- endif -%}
            {%- if composition != blank -%}<p>{{ composition }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="prd-details-panel__trust">
        <div class="prd-trust__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
