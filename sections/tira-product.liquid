<script>
(function() {
  var isMobile = window.matchMedia('(max-width: 900px)').matches;

  /* ── Swatches variant switcher ── */
  var swatches      = document.querySelectorAll('#prd-swatches input[type=radio]');
  var variantInput  = document.getElementById('prd-variant-input');
  var variantTitle  = document.getElementById('prd-variant-title');
  var priceDisplay  = document.getElementById('prd-price-display');
  var voletPrice       = document.getElementById('volet-price');
  var voletVariantName = document.getElementById('volet-variant-name');

  /* Fait défiler les galeries jusqu'à l'image de la variante.
     data-variant-img vaut -1 si la variante n'a pas d'image dédiée. */
  function syncGallery(imgIdx) {
    var idx = parseInt(imgIdx, 10);
    if (isNaN(idx) || idx < 0) return;

    var deskTarget = document.querySelector('.prd-gallery__img[data-img="' + idx + '"]');
    var gallery    = document.getElementById('prd-gallery');
    if (deskTarget && gallery && gallery.offsetParent !== null) {
      gallery.scrollTo({ top: deskTarget.offsetTop - gallery.offsetTop, behavior: 'smooth' });
    }

    var mobTarget = document.getElementById('vimg-' + idx);
    if (mobTarget && mobTarget.offsetParent !== null) {
      mobTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  /* Reconstruit le prix en préservant le balisage promo (prix barré). */
  function renderPrice(el, price, compare) {
    if (!el) return;
    if (compare) {
      el.innerHTML = '<span class="prd-price--sale"></span> <span class="prd-price--compare"></span>';
      el.querySelector('.prd-price--sale').textContent = price;
      el.querySelector('.prd-price--compare').textContent = compare;
    } else {
      el.textContent = price;
    }
  }

  /* Point d'entrée unique — utilisé par le Cover Flow, le volet et la sheet. */
  function applyVariant(radio) {
    if (!radio) return;
    var d = radio.dataset;
    if (variantInput) variantInput.value = d.variantId;
    if (variantTitle) variantTitle.textContent = d.variantTitle;
    if (window.TIRA_SHOW_PRICE) {
      renderPrice(priceDisplay, d.variantPrice, d.variantCompare);
      if (voletPrice) voletPrice.textContent = d.variantPrice;
    }
    if (voletVariantName) voletVariantName.textContent = d.variantTitle;

    document.querySelectorAll('.prd-volet-sw').forEach(function(b) {
      b.classList.toggle('active', b.dataset.variantId === d.variantId);
    });
    document.querySelectorAll('.prd-swatch-sheet__item').forEach(function(b) {
      b.classList.toggle('active', b.dataset.variantId === d.variantId);
    });

    syncGallery(d.variantImgidx);

    /* URL canonique de variante — attendu par la checklist SEO */
    if (window.history && history.replaceState) {
      var u = new URL(window.location.href);
      u.searchParams.set('variant', d.variantId);
      history.replaceState({}, '', u);
    }
  }

  swatches.forEach(function(sw) {
    sw.addEventListener('change', function() {
      if (this.checked) applyVariant(this);
    });
  });

  /* ── Volet sticky : toggle drawer au tap sur le handle ── */
  var volet       = document.getElementById('prd-volet');
  var voletToggle = document.getElementById('prd-volet-toggle');
  if (volet && voletToggle) {
    voletToggle.addEventListener('click', function() {
      var isOpen = volet.classList.toggle('is-open');
      voletToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    voletToggle.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); voletToggle.click(); }
    });
  }

  /* ── Volet : sélection variante depuis le drawer ── */
  document.querySelectorAll('.prd-volet-sw').forEach(function(btn) {
    btn.addEventListener('click', function() {
      /* Passe par le radio caché : il porte data-variant-img et data-variant-compare,
         et son 'change' resynchronise le Cover Flow. */
      var radio = document.querySelector('#prd-swatches input[data-variant-id="' + this.dataset.variantId + '"]');
      if (!radio || radio.disabled) return;
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });

  /* ── Volet : liens "Détails" et "Livraison" scroll vers les accordéons ── */
  var voletDetailsLink = document.getElementById('volet-details-link');
  var voletCareLink    = document.getElementById('volet-care-link');
  if (voletDetailsLink) {
    voletDetailsLink.addEventListener('click', function() {
      var detailsTrigger = document.getElementById('prd-details-trigger');
      if (detailsTrigger) { detailsTrigger.click(); }
      else {
        var accordion = document.querySelector('.prd-accordion');
        if (accordion) accordion.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      if (volet) volet.classList.remove('is-open');
    });
  }
  if (voletCareLink) {
    voletCareLink.addEventListener('click', function() {
      var careSection = document.querySelector('[data-accordion="care"], .prd-accordion--care');
      if (careSection) careSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      else {
        var accordion = document.querySelector('.prd-accordion');
        if (accordion) accordion.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      if (volet) volet.classList.remove('is-open');
    });
  }

  /* ── Dots indicateur galerie mobile ── */
  if (isMobile) {
    var vgallery  = document.getElementById('prd-vgallery');
    var dotsWrap  = document.getElementById('prd-vdots');
    var gallery   = document.getElementById('gallery-mobile');
    var wishBtn   = document.getElementById('prd-gallery-wish');

    if (vgallery && dotsWrap) {
      var images = vgallery.querySelectorAll('.prd-vgallery__img');
      var dots   = dotsWrap.querySelectorAll('.prd-vdot');

      /* IntersectionObserver : met à jour le dot actif */
      var imgObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            var idx = e.target.id.replace('vimg-', '');
            dots.forEach(function(d, i) { d.classList.toggle('active', String(i) === idx); });
          }
        });
      }, { threshold: 0.5 });

      images.forEach(function(img) { imgObs.observe(img); });
    }

    /* Afficher/masquer dots + wish selon position galerie */
    if (gallery && dotsWrap && wishBtn) {
      var visObs = new IntersectionObserver(function(entries) {
        var visible = entries[0].isIntersecting;
        dotsWrap.style.display  = visible ? 'flex' : 'none';
        wishBtn.style.display   = visible ? 'flex' : 'none';
      }, { threshold: 0.1 });
      visObs.observe(gallery);
    }
  }

  /* ── Volet sélection matière (mobile) ── */
  var swatchTrigger  = document.getElementById('prd-swatch-trigger');
  var swatchSheet    = document.getElementById('prd-swatch-sheet');
  var swatchBackdrop = document.getElementById('prd-swatch-sheet-backdrop');
  var swatchClose    = document.getElementById('prd-swatch-sheet-close');
  var triggerImg     = document.getElementById('swatch-trigger-img');
  var triggerName    = document.getElementById('swatch-trigger-name');

  function openSwatchSheet() {
    if (!swatchSheet) return;
    swatchSheet.classList.add('open');
    swatchSheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeSwatchSheet() {
    if (!swatchSheet) return;
    swatchSheet.classList.remove('open');
    swatchSheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  swatchTrigger  && swatchTrigger.addEventListener('click', openSwatchSheet);
  swatchBackdrop && swatchBackdrop.addEventListener('click', closeSwatchSheet);
  swatchClose    && swatchClose.addEventListener('click', closeSwatchSheet);

  document.querySelectorAll('.prd-swatch-sheet__item').forEach(function(item) {
    item.addEventListener('click', function() {
      if (this.getAttribute('aria-disabled') === 'true') return;

      /* Trigger visuel propre à la sheet (image + nom) */
      if (triggerImg && this.dataset.variantImg) triggerImg.src = this.dataset.variantImg;
      if (triggerName) triggerName.textContent = this.dataset.variantTitle;

      /* Le reste passe par applyVariant via le radio caché */
      var radio = document.querySelector('#prd-swatches input[data-variant-id="' + this.dataset.variantId + '"]');
      if (radio && !radio.disabled) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }

      closeSwatchSheet();
    });
  });

  /* ── Panel "Détails du produit" (mobile) ── */
  var trigger  = document.getElementById('prd-details-trigger');
  var panel    = document.getElementById('prd-details-panel');
  var backdrop = document.getElementById('prd-details-backdrop');
  var closeBtn = document.getElementById('prd-details-close');

  function openPanel()  { if (panel) { panel.classList.add('open'); document.body.style.overflow = 'hidden'; } }
  function closePanel() { if (panel) { panel.classList.remove('open'); document.body.style.overflow = ''; } }

  trigger  && trigger.addEventListener('click', openPanel);
  backdrop && backdrop.addEventListener('click', closePanel);
  closeBtn && closeBtn.addEventListener('click', closePanel);

  /* ── Accordéons (desktop inline + panel mobile) ── */
  document.querySelectorAll('.prd-accordion__btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item     = this.closest('.prd-accordion__item');
      var expanded = item.classList.contains('open');
      /* Fermer les autres dans le même groupe */
      var group = this.closest('.prd-accordion');
      if (group) group.querySelectorAll('.prd-accordion__item.open').forEach(function(o) {
        o.classList.remove('open');
        o.querySelector('.prd-accordion__btn').setAttribute('aria-expanded', 'false');
        o.querySelector('.prd-accordion__body').style.maxHeight = null;
      });
      if (!expanded) {
        item.classList.add('open');
        this.setAttribute('aria-expanded', 'true');
        item.querySelector('.prd-accordion__body').style.maxHeight =
          item.querySelector('.prd-accordion__body').scrollHeight + 'px';
      }
    });
  });

  /* ── Wishlist ──
     Gérée globalement par assets/tiraboschi.js (délégation + store unique
     'tira_wishlist'). Le handler local a été retiré : il doublonnait le
     handler global sur le même bouton, chaque clic s'annulait donc lui-même. */

  /* ESC ferme les panels */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closePanel(); closeSwatchSheet(); }
  });

  /* ══════════════════════════════════════════
     HERO PLEIN ÉCRAN — enchaînement des visuels au scroll
     Le nom de transition (morphing depuis la grille) reste porté par
     le visuel actif : on le déplace en même temps que la classe .on.
  ══════════════════════════════════════════ */
  (function() {
    var hero = document.getElementById('prd-hero');
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var frames = Array.prototype.slice.call(hero.querySelectorAll('.prd-hero__frame'));
    var bar    = document.getElementById('prd-hero-bar');
    var count  = document.getElementById('prd-hero-count');
    var cur    = -1;
    var pending = false;

    function paint() {
      pending = false;
      var r = hero.getBoundingClientRect();
      var course = r.height - window.innerHeight;
      if (course <= 0) return;

      var p = Math.max(0, Math.min(1, -r.top / course));
      if (bar) bar.style.width = (p * 100) + '%';
      hero.classList.toggle('is-engaged', p > 0.04);

      var i = Math.min(frames.length - 1, Math.floor(p * frames.length));
      if (i === cur) return;
      cur = i;
      frames.forEach(function(f, j) { f.classList.toggle('on', j === i); });
      if (count) count.textContent = (i + 1 < 10 ? '0' : '') + (i + 1);
    }

    window.addEventListener('scroll', function() {
      if (!pending) { pending = true; requestAnimationFrame(paint); }
    }, { passive: true });
    window.addEventListener('resize', function() {
      if (!pending) { pending = true; requestAnimationFrame(paint); }
    }, { passive: true });

    paint();
  })();

  /* ══════════════════════════════════════════
     COVER FLOW — navigation matières iPod-style
  ══════════════════════════════════════════ */
  (function() {
    var stage = document.getElementById('prd-coverflow-stage');
    if (!stage) return;

    var cards  = Array.from(stage.querySelectorAll('.prd-coverflow__card'));
    var radios = Array.from(document.querySelectorAll('#prd-swatches input[type=radio]'));
    var count  = cards.length;
    var cur    = 0;

    /* Index initial depuis le radio coché */
    radios.forEach(function(r, i) { if (r.checked) cur = i; });

    function getT(offset) {
      if (offset === 0) return { tx: '-50%', ry: '0deg', sc: 1, op: 1, zi: 100 };
      var s   = offset < 0 ? -1 : 1;
      var abs = Math.abs(offset);
      var gap = 96 + abs * 12;
      return {
        tx:  'calc(-50% + ' + (s * gap) + 'px)',
        ry:  (-s * 40) + 'deg',
        sc:  Math.max(0.52, 1 - abs * 0.2),
        op:  Math.max(0, 1 - abs * 0.35),
        zi:  Math.max(0, 100 - abs * 20)
      };
    }

    function render() {
      cards.forEach(function(card, i) {
        var t = getT(i - cur);
        card.style.transform = 'translateX(' + t.tx + ') translateY(-50%) rotateY(' + t.ry + ') scale(' + t.sc + ')';
        card.style.opacity   = t.op;
        card.style.zIndex    = t.zi;
        card.classList.toggle('is-center',  i === cur);
        card.classList.toggle('is-visible', Math.abs(i - cur) <= 2);
        card.setAttribute('aria-selected', i === cur ? 'true' : 'false');
      });

      var prevBtn = document.getElementById('prd-coverflow-prev');
      var nextBtn = document.getElementById('prd-coverflow-next');
      if (prevBtn) prevBtn.disabled = cur === 0;
      if (nextBtn) nextBtn.disabled = cur === count - 1;
    }

    function goTo(idx) {
      idx = Math.max(0, Math.min(count - 1, idx));
      if (idx === cur) return;
      cur = idx;
      render();
      var r = radios[idx];
      if (r && !r.disabled) {
        r.checked = true;
        r.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    /* Clic sur une carte */
    cards.forEach(function(card, i) {
      card.addEventListener('click', function() { goTo(i); });
    });

    /* Boutons nav */
    var prevBtn = document.getElementById('prd-coverflow-prev');
    var nextBtn = document.getElementById('prd-coverflow-next');
    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(cur - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(cur + 1); });

    /* Clavier */
    document.getElementById('prd-coverflow') && document.getElementById('prd-coverflow').addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(cur - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(cur + 1); }
    });

    /* Touch swipe */
    var tx0 = 0;
    stage.addEventListener('touchstart', function(e) { tx0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend',   function(e) {
      var dx = e.changedTouches[0].clientX - tx0;
      if (Math.abs(dx) > 32) goTo(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });

    /* Mouse drag */
    var mx0 = 0, dragging = false;
    stage.addEventListener('mousedown',  function(e) { mx0 = e.clientX; dragging = true; });
    stage.addEventListener('mouseup',    function(e) {
      if (!dragging) return;
      var dx = e.clientX - mx0;
      if (Math.abs(dx) > 32) goTo(cur + (dx < 0 ? 1 : -1));
      dragging = false;
    });
    stage.addEventListener('mouseleave', function() { dragging = false; });

    /* Sync depuis la swatch-sheet */
    radios.forEach(function(r, i) {
      r.addEventListener('change', function() {
        if (this.checked && i !== cur) { cur = i; render(); }
      });
    });

    /* Rendu initial */
    render();
  })();

})();
</script>

{% schema %}
{
  "name": "Fiche produit TIRABOSCHI",
  "tag": "div",
  "class": "tira-product-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullscreen_hero",
      "label": "Premier écran plein cadre",
      "info": "Affiche la première image en plein écran avec le nom et le prix en surimpression, puis retour à la mise en page classique.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dimensions",
      "label": "Afficher section dimensions même si vide",
      "default": true
    }
  ],
  "presets": [{ "name": "Fiche produit TIRABOSCHI" }]
}
{% endschema %}
