  <section class="story-section story-section--dark story-section--entretien" aria-labelledby="story-5-title" data-tira-reveal>
    <div class="story-section__entretien-inner">
      <p class="story-num">05 / 05</p>
      <p class="story-label">Entretien du cuir</p>
