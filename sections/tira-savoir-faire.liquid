{% comment %}
  ═══════════════════════════════════════════════════════════════
  TIRABOSCHI · Savoir-Faire — Page éditoriale
  ═══════════════════════════════════════════════════════════════
  Structure :
  1. Hero fond --tira-grey + breadcrumb
  2. Intro citation + stats (48-72h / 1 artisan / 6 techniques)
  3. Les 6 Techniques — grille 3×2
  4. La Transmission — 3 sous-sections alternées
  5. CTA fond noir — lien Sur Mesure
  Styles : scoped .sf-*
{% endcomment %}

<style>
  /* ── Variables locales ── */
  .sf-page {
    --tira-black: #0a0a0a;
    --tira-white: #ffffff;
    --tira-grey: #f7f5f2;
    --tira-border: #e8e8e8;
    --tira-ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--tira-black);
  }

  /* ── 1. Hero ── */
  .sf-hero {
    background: var(--tira-grey);
    padding: calc(var(--content-top) + 80px) 40px 80px;
    text-align: center;
  }
  .sf-hero__eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 24px;
    opacity: 0.5;
  }
  .sf-hero__title {
    font-size: 56px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    line-height: 1.1;
  }
  .sf-hero__sub {
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 48px;
    opacity: 0.6;
  }
  .sf-hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.3;
  }
  .sf-hero__scroll-line {
    width: 1px;
    height: 48px;
    background: currentColor;
  }
  .sf-hero__scroll-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  @media (max-width: 768px) {
    .sf-hero { padding: calc(var(--content-top) + 48px) 24px 48px; }
    .sf-hero__title { font-size: 36px; }
  }

  /* ── 2. Intro ── */
  .sf-intro {
    padding: 96px 40px;
    background: var(--tira-white);
    max-width: 1200px;
    margin: 0 auto;
  }
  .sf-intro__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .sf-intro__quote {
    font-size: 28px;
    font-weight: 400;
    font-style: italic;
    line-height: 1.4;
    margin: 0;
    border-left: 1px solid var(--tira-black);
    padding-left: 32px;
  }
  .sf-intro__body {
    font-size: 14px;
    line-height: 1.8;
    opacity: 0.75;
    margin: 0 0 40px;
  }
  .sf-intro__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .sf-intro__stat-num {
    font-size: 32px;
    font-weight: 400;
    display: block;
    margin-bottom: 4px;
  }
  .sf-intro__stat-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .sf-intro__inner { grid-template-columns: 1fr; gap: 40px; }
    .sf-intro { padding: 64px 24px; }
  }
  @media (max-width: 600px) {
    .sf-intro__stats { grid-template-columns: 1fr 1fr; }
    .sf-intro__quote { font-size: 22px; }
  }

  /* ── 3. Les 6 Techniques — chapitrage épinglé ──
     L'image reste, le texte progresse. Structure des pages collection
     d'Audemars Piguet appliquée aux six gestes de l'atelier. */
  .sf-chapters {
    position: relative;
    height: 500vh;
    background: var(--tira-grey);
  }
  .sf-chapters__sticky {
    position: sticky; top: 0;
    height: 100svh;
    display: grid; grid-template-columns: 1fr 1fr;
  }

  .sf-chapters__visual {
    position: relative; overflow: hidden;
    background: var(--tira-black);
  }
  .sf-chapters__img {
    position: absolute; inset: 0;
    opacity: 0; transform: scale(1.05);
    transition: opacity 1s var(--tira-ease), transform 1.5s var(--tira-ease);
  }
  .sf-chapters__img.on { opacity: 1; transform: scale(1); }
  .sf-chapters__img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sf-chapters__text {
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 5vw; position: relative;
  }
  .sf-chapters__head { margin-bottom: 40px; }
  .sf-chapters__label {
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    opacity: 0.35; display: block; margin-bottom: 12px;
  }
  .sf-chapters__title {
    font-size: clamp(26px, 3vw, 40px); font-weight: 400;
    letter-spacing: -0.02em; margin: 0;
  }

  .sf-chapters__ticks { display: flex; gap: 10px; margin-bottom: 44px; }
  .sf-chapters__tick {
    width: 26px; height: 1px; background: var(--tira-black);
    opacity: 0.12; transition: opacity 0.5s var(--tira-ease);
  }
  .sf-chapters__tick.on { opacity: 1; }

  .sf-chapters__stack { position: relative; }
  .sf-chapter {
    position: absolute; top: 0; left: 0; right: 0;
    opacity: 0; visibility: hidden;
    transition: opacity 0.6s var(--tira-ease), visibility 0.6s;
  }
  .sf-chapter.on { position: relative; opacity: 1; visibility: visible; }
  .sf-chapter__num {
    font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase;
    opacity: 0.32; margin: 0 0 18px;
  }
  .sf-chapter__name {
    font-size: clamp(28px, 3.4vw, 46px); font-weight: 400;
    line-height: 1.04; letter-spacing: -0.02em; margin: 0 0 20px;
  }
  .sf-chapter__desc {
    font-size: 13px; line-height: 1.9; opacity: 0.58;
    max-width: 46ch; margin: 0;
  }
  .sf-chapter__fact {
    margin: 30px 0 0; padding-top: 20px;
    border-top: 1px solid var(--tira-border);
    font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; opacity: 0.4;
  }

  @media (max-width: 900px) {
    .sf-chapters { height: 440vh; }
    .sf-chapters__sticky { grid-template-columns: 1fr; grid-template-rows: 40svh 1fr; }
    .sf-chapters__text { padding: 32px 6vw; justify-content: flex-start; }
    .sf-chapters__head { margin-bottom: 24px; }
    .sf-chapters__ticks { margin-bottom: 28px; }
    .sf-chapter__desc { font-size: 13px; }
  }

  /* Sans animation : les six techniques redeviennent une liste lisible */
  @media (prefers-reduced-motion: reduce) {
    .sf-chapters { height: auto; }
    .sf-chapters__sticky {
      position: relative; height: auto;
      grid-template-columns: 1fr; gap: 0;
    }
    .sf-chapters__visual { display: none; }
    .sf-chapters__ticks { display: none; }
    .sf-chapters__text { padding: 64px 6vw; }
    .sf-chapter {
      position: relative; opacity: 1; visibility: visible;
      margin-bottom: 56px;
    }
  }

  /* ── 4. La Transmission ── */
  .sf-transmission__header {
    text-align: center;
    padding: 96px 40px 64px;
    background: var(--tira-white);
  }
  .sf-transmission__eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
    display: block;
    margin-bottom: 16px;
  }
  .sf-transmission__title {
    font-size: 40px;
    font-weight: 400;
    margin: 0;
  }
  .sf-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
  }
  .sf-split--reverse { direction: rtl; }
  .sf-split--reverse > * { direction: ltr; }
  .sf-split__img {
    overflow: hidden;
    background: var(--tira-grey);
  }
  .sf-split__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sf-split__text {
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  .sf-split--dark .sf-split__text {
    background: var(--tira-black);
    color: var(--tira-white);
  }
  .sf-split--grey .sf-split__text {
    background: var(--tira-grey);
  }
  .sf-split--white .sf-split__text {
    background: var(--tira-white);
  }
  .sf-split__watermark {
    font-size: 120px;
    font-weight: 400;
    font-style: italic;
    opacity: 0.05;
    position: absolute;
    bottom: -20px;
    right: 32px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .sf-split__eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 16px;
    display: block;
  }
  .sf-split__heading {
    font-size: 28px;
    font-weight: 400;
    margin: 0 0 24px;
  }
  .sf-split__body {
    font-size: 14px;
    line-height: 1.85;
    opacity: 0.75;
    margin: 0;
  }
  @media (max-width: 900px) {
    .sf-split {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .sf-split--reverse { direction: ltr; }
    .sf-split__img { aspect-ratio: 3/2; min-height: 280px; }
    .sf-split__text { padding: 48px 24px; }
    .sf-transmission__header { padding: 64px 24px 40px; }
    .sf-transmission__title { font-size: 28px; }
  }

  /* ── 5. CTA ── */
  .sf-cta {
    background: var(--tira-black);
    color: var(--tira-white);
    padding: 96px 40px;
    text-align: center;
  }
  .sf-cta__eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.45;
    display: block;
    margin-bottom: 24px;
  }
  .sf-cta__title {
    font-size: 40px;
    font-weight: 400;
    margin: 0 0 16px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .sf-cta__sub {
    font-size: 14px;
    letter-spacing: 0.05em;
    opacity: 0.55;
    margin: 0 0 48px;
  }
  .sf-cta__link {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--tira-white);
    transition: opacity 0.3s;
  }
  .sf-cta__link:hover { opacity: 0.6; }
  @media (max-width: 768px) {
    .sf-cta { padding: 64px 24px; }
    .sf-cta__title { font-size: 28px; }
  }

  /* ── Reveal animations ── */
  [data-tira-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s var(--tira-ease), transform 0.9s var(--tira-ease);
  }
  [data-tira-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
</style>

<div class="sf-page" id="MainContent">

  {%- comment -%} ══ 1. HERO ══ {%- endcomment -%}
  <section class="sf-hero" aria-labelledby="sf-hero-title">
    <p class="sf-hero__eyebrow" data-tira-reveal>La Maison · Depuis 1904</p>
    <h1 class="sf-hero__title" id="sf-hero-title" data-tira-reveal>Savoir-Faire</h1>
    <p class="sf-hero__sub" data-tira-reveal>L'excellence transmise de main en main</p>
    <div class="sf-hero__scroll" aria-hidden="true" data-tira-reveal>
      <div class="sf-hero__scroll-line"></div>
      <span class="sf-hero__scroll-label">Découvrir</span>
    </div>
  </section>

  {%- comment -%} ══ 2. INTRO ══ {%- endcomment -%}
  <section class="sf-intro" aria-label="Philosophie artisanale">
    <div class="sf-intro__inner">
      <blockquote class="sf-intro__quote" data-tira-reveal>
        « Chaque pièce est façonnée par un seul artisan,
        de la première coupe à la livraison signée. »
      </blockquote>
      <div>
        <p class="sf-intro__body" data-tira-reveal>
          Depuis 1904, TIRABOSCHI Paris perpétue une tradition maroquinière fondée sur la transmission directe du geste. Nos artisans ne suivent pas une chaîne de production — ils accompagnent chaque pièce de son premier tracé jusqu'à son conditionnement final. Un artisan. Un sac. Soixante-douze heures de travail à la main.
        </p>
        <p class="sf-intro__body" data-tira-reveal>
          C'est ce choix radical — un seul homme ou une seule femme par pièce — qui définit TIRABOSCHI et le distingue des manufactures de série. La responsabilité est entière, la signature authentique.
        </p>
        <div class="sf-intro__stats" role="list" aria-label="Chiffres clés">
          <div data-tira-reveal role="listitem">
            <span class="sf-intro__stat-num">48–72h</span>
            <span class="sf-intro__stat-label">Par pièce, à la main</span>
          </div>
          <div data-tira-reveal role="listitem">
            <span class="sf-intro__stat-num">1</span>
            <span class="sf-intro__stat-label">Artisan par sac, de A à Z</span>
          </div>
          <div data-tira-reveal role="listitem">
            <span class="sf-intro__stat-num">3 400</span>
            <span class="sf-intro__stat-label">Points sellier par pièce</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ══ 3. LES 6 TECHNIQUES ══ {%- endcomment -%}
  <section class="sf-chapters" id="sf-chapters" aria-labelledby="sf-tech-title">
    <div class="sf-chapters__sticky">

      <div class="sf-chapters__visual" aria-hidden="true">
        <div class="sf-chapters__img on">
          {%- if section.settings.tech_img_1 != blank -%}
            <img src="{{ section.settings.tech_img_1 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_1 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_1 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_1.alt | default: 'Couture Sellier — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="eager">
          {%- else -%}
            <img src="{{ 'BOSCHI0919.jpg' | file_url }}"
                 alt="Couture Sellier — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="eager">
          {%- endif -%}
        </div>
        <div class="sf-chapters__img">
          {%- if section.settings.tech_img_2 != blank -%}
            <img src="{{ section.settings.tech_img_2 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_2 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_2 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_2.alt | default: 'Coupe et Gabarit — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="lazy">
          {%- else -%}
            <img src="{{ 'Asset_Mains_1.png' | file_url }}"
                 alt="Coupe et Gabarit — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sf-chapters__img">
          {%- if section.settings.tech_img_3 != blank -%}
            <img src="{{ section.settings.tech_img_3 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_3 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_3 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_3.alt | default: 'Teinture et Finitions — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="lazy">
          {%- else -%}
            <img src="{{ 'BOSCHI0103.jpg' | file_url }}"
                 alt="Teinture et Finitions — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sf-chapters__img">
          {%- if section.settings.tech_img_4 != blank -%}
            <img src="{{ section.settings.tech_img_4 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_4 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_4 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_4.alt | default: 'Assemblage — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="lazy">
          {%- else -%}
            <img src="{{ 'Asset_atelier_1.png' | file_url }}"
                 alt="Assemblage — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sf-chapters__img">
          {%- if section.settings.tech_img_5 != blank -%}
            <img src="{{ section.settings.tech_img_5 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_5 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_5 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_5.alt | default: 'Pose des Quincailleries — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="lazy">
          {%- else -%}
            <img src="{{ 'Asset_Atelier_6.png' | file_url }}"
                 alt="Pose des Quincailleries — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sf-chapters__img">
          {%- if section.settings.tech_img_6 != blank -%}
            <img src="{{ section.settings.tech_img_6 | image_url: width: 1400 }}"
                 srcset="{{ section.settings.tech_img_6 | image_url: width: 800 }} 800w,
                         {{ section.settings.tech_img_6 | image_url: width: 1400 }} 1400w"
                 sizes="(max-width: 900px) 100vw, 50vw"
                 alt="{{ section.settings.tech_img_6.alt | default: 'Lustre et Contrôle — atelier TIRABOSCHI Paris' }}"
                 width="1400" height="1750" loading="lazy">
          {%- else -%}
            <img src="{{ 'BOSCHI0154.jpg' | file_url }}"
                 alt="Lustre et Contrôle — atelier TIRABOSCHI Paris"
                 width="1400" height="1750" loading="lazy">
          {%- endif -%}
        </div>
      </div>

      <div class="sf-chapters__text">
        <div class="sf-chapters__head">
          <span class="sf-chapters__label">Expertise</span>
          <h2 class="sf-chapters__title" id="sf-tech-title">Les 6 Techniques</h2>
        </div>

        <div class="sf-chapters__ticks" aria-hidden="true">
          <span class="sf-chapters__tick on"></span>
          <span class="sf-chapters__tick"></span>
          <span class="sf-chapters__tick"></span>
          <span class="sf-chapters__tick"></span>
          <span class="sf-chapters__tick"></span>
          <span class="sf-chapters__tick"></span>
        </div>

        <div class="sf-chapters__stack">
        <article class="sf-chapter on" aria-labelledby="sf-tech-01">
          <p class="sf-chapter__num">Technique 01</p>
          <h3 class="sf-chapter__name" id="sf-tech-01">Couture Sellier</h3>
          <p class="sf-chapter__desc">
            Point sellier à deux aiguilles, fil de lin ciré, 8 à 10 points par centimètre.
          La couture la plus robuste qui soit — celle des selliers de cour depuis le
          XVIII<sup>e</sup> siècle. Chaque point est passé à la main, l'un après l'autre.
          </p>
          <p class="sf-chapter__fact">8 à 10 points au centimètre</p>
        </article>
        <article class="sf-chapter" aria-labelledby="sf-tech-02">
          <p class="sf-chapter__num">Technique 02</p>
          <h3 class="sf-chapter__name" id="sf-tech-02">Coupe &amp; Gabarit</h3>
          <p class="sf-chapter__desc">
            Gabarits en bois centenaires, coupe entièrement à la main, respect absolu du sens
          du grain. Chaque peau est lue avant d'être taillée — aucune coupe n'est identique.
          Le tracé, la lame, le geste : tout est à la main.
          </p>
          <p class="sf-chapter__fact">Gabarits centenaires</p>
        </article>
        <article class="sf-chapter" aria-labelledby="sf-tech-03">
          <p class="sf-chapter__num">Technique 03</p>
          <h3 class="sf-chapter__name" id="sf-tech-03">Teinture &amp; Finitions</h3>
          <p class="sf-chapter__desc">
            Teintures à l'eau naturelles, trois passes successives, séchage de 24 heures entre
          chaque couche. La couleur pénètre la fibre plutôt que de la recouvrir.
          Le résultat vieillit, il ne s'écaille pas.
          </p>
          <p class="sf-chapter__fact">Trois passes · 24 h de séchage</p>
        </article>
        <article class="sf-chapter" aria-labelledby="sf-tech-04">
          <p class="sf-chapter__num">Technique 04</p>
          <h3 class="sf-chapter__name" id="sf-tech-04">Assemblage</h3>
          <p class="sf-chapter__desc">
            Collage à la colle de peau naturelle, martelage à main levée, pressage à froid.
          L'assemblage définit la tenue de la pièce pour les décennies à venir.
          Aucune colle synthétique, aucun raccourci.
          </p>
          <p class="sf-chapter__fact">Colle de peau · pressage à froid</p>
        </article>
        <article class="sf-chapter" aria-labelledby="sf-tech-05">
          <p class="sf-chapter__num">Technique 05</p>
          <h3 class="sf-chapter__name" id="sf-tech-05">Pose des Quincailleries</h3>
          <p class="sf-chapter__desc">
            Fermoirs, passants, anneaux — chaque quincaillerie est sertie à la main, jamais à
          la machine. La précision au dixième de millimètre, à l'œil et au toucher.
          Laiton massif, finition satiné, pour l'éternité.
          </p>
          <p class="sf-chapter__fact">Laiton massif · sertissage main</p>
        </article>
        <article class="sf-chapter" aria-labelledby="sf-tech-06">
          <p class="sf-chapter__num">Technique 06</p>
          <h3 class="sf-chapter__name" id="sf-tech-06">Lustre &amp; Contrôle</h3>
          <p class="sf-chapter__desc">
