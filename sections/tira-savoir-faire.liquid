<script>
(function () {
  'use strict';
  /* Chapitrage épinglé — l'image reste, le texte progresse.
     Un seul écouteur de scroll, throttlé par requestAnimationFrame. */
  var wrap = document.getElementById('sf-chapters');
  if (!wrap) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var chapters = Array.prototype.slice.call(wrap.querySelectorAll('.sf-chapter'));
  var visuals  = Array.prototype.slice.call(wrap.querySelectorAll('.sf-chapters__img'));
  var ticks    = Array.prototype.slice.call(wrap.querySelectorAll('.sf-chapters__tick'));
  if (!chapters.length) return;

  var cur = -1;
  var pending = false;

  function paint() {
    pending = false;
    var r = wrap.getBoundingClientRect();
    var course = r.height - window.innerHeight;
    if (course <= 0) return;

    var p = Math.max(0, Math.min(0.9999, -r.top / course));
    var i = Math.floor(p * chapters.length);
    if (i === cur) return;
    cur = i;

    chapters.forEach(function (c, j) { c.classList.toggle('on', j === i); });
    visuals.forEach(function (v, j)  { v.classList.toggle('on', j === i); });
    ticks.forEach(function (t, j)    { t.classList.toggle('on', j <= i); });
  }

  function onScroll() {
    if (!pending) { pending = true; requestAnimationFrame(paint); }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  paint();
})();
</script>

