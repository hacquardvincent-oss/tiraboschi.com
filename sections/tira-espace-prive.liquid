                <div class="ep-order__group">
                  <label class="ep-order__lbl" for="ep-bespoke-budget">Budget indicatif</label>
                  <select class="ep-order__select ep-order__input" id="ep-bespoke-budget" name="contact[budget]">
                    <option value="">Enveloppe…</option>
                    <option>3 000 – 6 000 €</option>
                    <option>6 000 – 12 000 €</option>
                    <option>12 000 – 25 000 €</option>
                    <option>+ 25 000 € — pièce d'exception</option>
                  </select>
                </div>
                <div class="ep-order__group ep-order__group--full">
                  <label class="ep-order__lbl" for="ep-bespoke-vision">Votre vision</label>
                  <textarea class="ep-order__textarea" id="ep-bespoke-vision"
                            name="contact[body]"
                            placeholder="Décrivez votre idée, l'usage, l'occasion, une référence visuelle, une contrainte de format… Tout ce qui peut guider l'artisan."></textarea>
                </div>
                <div class="ep-bespoke__cta-wrap">
                  <button class="ep-bespoke__cta" type="submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                    Envoyer mon brief
                  </button>
                </div>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

    {%- else -%}
      {# ════════════════════════════════════════════════════
         CONNECTÉ — accès en cours de traitement
         ════════════════════════════════════════════════════ #}
      <div class="ep-pending" data-tira-dark-hero>
        <div class="ep-pending__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h1 class="ep-pending__title">Accès en cours de traitement</h1>
        <p class="ep-pending__sub">
          Votre demande a bien été reçue, {{ customer.first_name }}.<br>
          Notre équipe valide votre accès à l'Espace Privé sous 48 heures et vous contacte directement.
        </p>
        <a class="ep-pending__cta" href="/pages/contact">Nous contacter →</a>
      </div>
    {%- endif -%}

  {%- else -%}
    {# ════════════════════════════════════════════════════
       NON CONNECTÉ — porte d'entrée
       ════════════════════════════════════════════════════ #}
    <div class="ep-gate" data-tira-dark-hero>
      <span class="ep-gate__filigree" aria-hidden="true">Privé</span>
      <div class="ep-gate__content">
        <p class="ep-gate__eyebrow">Espace Privé · TIRABOSCHI Paris</p>
        <h1 class="ep-gate__title">Un espace<br>réservé à quelques-uns</h1>
        <p class="ep-gate__sub">
          Les pièces d'exception ne sont pas sur la boutique. Elles sont présentées — sur invitation — à nos clients les plus proches, au moment où elles naissent.
        </p>
        <div class="ep-gate__actions">
          <a class="ep-gate__btn ep-gate__btn--solid" href="/account/login?return_url=/pages/espace-prive">
            Se connecter
          </a>
          <span class="ep-gate__divider">ou</span>
          <a class="ep-gate__link" href="#ep-request-section">Demander l'accès</a>
        </div>
      </div>
    </div>

    {# Formulaire demande d'accès #}
    <div class="ep-request" id="ep-request-section">
      <div class="ep-request__inner">
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:rgba(255,255,255,.4);margin-bottom:40px;">
          Demander l'accès à l'Espace Privé
        </p>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <div style="text-align:center;padding:40px 0;">
              <p style="font-size:22px;font-style:italic;color:#fff;margin-bottom:12px;">Demande envoyée</p>
              <p style="font-size:13px;color:rgba(255,255,255,.4);line-height:1.7;">Notre équipe revient vers vous sous 48 heures.</p>
            </div>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="demande-acces-prive">
            <label class="ep-request__label" for="ep-req-name">Votre nom</label>
            <input class="ep-request__field" type="text" id="ep-req-name"
                   name="contact[name]" required placeholder="Prénom Nom">

            <label class="ep-request__label" for="ep-req-email">Email</label>
            <input class="ep-request__field" type="email" id="ep-req-email"
                   name="contact[email]" required placeholder="votre@email.com">

            <label class="ep-request__label" for="ep-req-how">Comment nous connaissez-vous ?</label>
            <select class="ep-request__field ep-request__select" id="ep-req-how" name="contact[source]">
              <option value="">Sélectionner…</option>
              <option>Recommandation d'un client</option>
              <option>Presse / Magazine</option>
              <option>Instagram @boschi_paris</option>
              <option>Boutique / Atelier</option>
              <option>Autre</option>
            </select>

            <label class="ep-request__label" for="ep-req-body">Votre message (optionnel)</label>
            <textarea class="ep-request__field" id="ep-req-body"
                      name="contact[body]"
                      rows="4"
                      placeholder="Dites-nous ce qui vous attire dans TIRABOSCHI…"></textarea>

            <button class="ep-request__btn" type="submit">Envoyer ma demande →</button>
            <p class="ep-request__note">Réponse sous 48h · Aucune obligation d'achat</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

  {%- endif -%}
</div>

<script>
(function() {
  /* ── Navigation interne portail ── */
  var navBtns = document.querySelectorAll('[data-ep-nav]');
  if (!navBtns.length) return;

  navBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = btn.getAttribute('data-ep-nav');
      navBtns.forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      document.querySelectorAll('.ep-section').forEach(function(s) { s.classList.remove('is-active'); });
      var sec = document.getElementById('ep-section-' + target);
      if (sec) {
        sec.classList.add('is-active');
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* ── Scroll anchor pour "Demander l'accès" ── */
  var anchor = document.querySelector('a[href="#ep-request-section"]');
  if (anchor) {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      var target = document.getElementById('ep-request-section');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  /* ── dark-hero ── */
  if (document.querySelector('[data-tira-dark-hero]')) {
    var hdr = document.getElementById('shopify-section-tira-header');
    if (hdr) {
      var inner = hdr.querySelector('.hdr');
      if (inner) { inner.classList.add('hdr--dark-hero'); }
    }
  }
})();
</script>

