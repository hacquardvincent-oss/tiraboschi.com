<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0927/5890/1079/files/Favicon_T_32x32_-_noir.png">
    {%- endif -%}

    <title>
      {%- if request.page_type == 'index' -%}
        {{ shop.name }} — Maroquinerie de Luxe Française depuis 1904
      {%- else -%}
        {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- comment -%} ── Playfair Display 400 — single weight, latin subset ── {%- endcomment -%}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&display=swap&subset=latin">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&display=swap&subset=latin" rel="stylesheet">

    {%- comment -%} ── Theme CSS ── {%- endcomment -%}
    {{ 'tiraboschi.css' | asset_url | stylesheet_tag }}
    {%- if template contains 'product' -%}
      {{ 'tira-preorder.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- comment -%} ── SEO JSON-LD + hreflang (snippet central) ── {%- endcomment -%}
    {%- render 'tira-seo-schemas' -%}
  </head>

  <body class="template-{{ template | replace: '.', '-' }} page-type-{{ request.page_type }}">
    <div id="tira-page-overlay" aria-hidden="true"></div>

    {%- comment -%} ── Drop bar site-wide (si drop actif dans settings) ── {%- endcomment -%}
    {%- if settings.drop_active -%}
      {%- render 'tira-drop-bar' -%}
    {%- endif -%}

    {%- comment -%} ── Géo-banner suggestion marché (uniquement si setting activé) ── {%- endcomment -%}
    {%- if settings.geo_banner_enabled and shop.published_locales.size > 1 -%}
      {%- render 'tira-geo-banner' -%}
    {%- endif -%}

    {%- section 'tira-header' -%}

    {%- comment -%} ── Guard : restaure les icônes mobile si un script externe les supprime ── {%- endcomment -%}
    <script>
    ;(function(){
      var hdrM = document.querySelector('.hdr__m');
      if (!hdrM) return;
      var _snap = hdrM.innerHTML;

      function _check() {
        if (window.innerWidth > 1200) return;
        var icons = hdrM.querySelectorAll('.hdr__m-icon');
        if (icons.length === 0) {
          /* Icônes supprimées du DOM → restaurer */
          _obs.disconnect();
          hdrM.innerHTML = _snap;
          /* Ré-attacher le listener hamburger */
          var btn = document.getElementById('mobile-menu-btn');
          var nav = document.getElementById('mobile-nav');
          if (btn && nav) {
            btn.addEventListener('click', function() {
              var open = btn.getAttribute('aria-expanded') === 'true';
              btn.setAttribute('aria-expanded', open ? 'false' : 'true');
              nav.classList.toggle('open', !open);
              nav.setAttribute('aria-hidden', open ? 'true' : 'false');
              document.body.classList.toggle('nav-open', !open);
            });
          }
          _obs.observe(hdrM, {childList: true, subtree: true});
          return;
        }
        /* Icônes présentes mais peut-être encapsulées dans un parent caché */
        for (var i = 0; i < icons.length; i++) {
          var el = icons[i];
          if (window.getComputedStyle(el).display === 'none') {
            var p = el.parentNode;
            while (p && p !== hdrM) {
              p.style.setProperty('display', 'flex', 'important');
              p.style.setProperty('visibility', 'visible', 'important');
              p = p.parentNode;
            }
            el.style.setProperty('display', 'flex', 'important');
          }
        }
      }

      var _obs = new MutationObserver(_check);
      _obs.observe(hdrM, {childList: true, subtree: true});
      [100, 300, 800, 2000].forEach(function(t){ setTimeout(_check, t); });
      window.addEventListener('load', _check);
    })();
    </script>

    <main id="MainContent" role="main" data-page-type="{{ request.page_type }}">
      {{ content_for_layout }}
    </main>

    {%- section 'tira-footer' -%}

    {%- comment -%} ── Newsletter popup (8s ou 40% scroll, 1×/30 jours) ── {%- endcomment -%}
    {%- if settings.newsletter_popup_enabled -%}
      {%- render 'tira-newsletter-popup' -%}
    {%- endif -%}

    {%- comment -%} ── Lenis avant tiraboschi.js (defer = ordre DOM) ── {%- endcomment -%}
    {%- if settings.lenis_smooth_scroll -%}
      <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js" defer></script>
    {%- endif -%}

    {%- comment -%} ── JS principal ── {%- endcomment -%}
    <script src="{{ 'tiraboschi.js' | asset_url }}" defer></script>
  </body>
</html>
